#!/usr/bin/env python3
"""trail - a task ledger that lives in your repo.

Single file, standard library only, Python 3.9+.
The point is not the task list; it is the decision log inside each task.
"""
import argparse
import contextlib
import json
import os
import random
import re
import shutil
import sys
import unicodedata
from dataclasses import dataclass, field
from datetime import date, datetime
from pathlib import Path

try:
    import fcntl
except ImportError:      # Windows: no advisory locks, writes stay unserialised
    fcntl = None

VERSION = "0.4.0"

# --------------------------------------------------------------------------
# the frontmatter contract - every status, level and field trail knows, in one
# place. Every other list is derived from these. Field names stay literal in the
# code: FIELDS is the list of them, not a layer in front of them.
# --------------------------------------------------------------------------
LEVELS = ("T1", "T2")
STATUSES = ("open", "active", "blocked", "done")   # board columns and work order
OPEN, ACTIVE, BLOCKED, DONE = STATUSES
IN_PROGRESS = (ACTIVE, BLOCKED)                    # what the writers target, in this order
SETTABLE_STATUSES = (OPEN, ACTIVE, BLOCKED)        # closing is `trail done`
FIELDS = {        # frontmatter key -> (required, kind); order is the template's order
    "id": (True, "str"),
    "title": (True, "str"),
    "level": (True, "level"),
    "status": (True, "status"),
    "created": (True, "date"),
    "started": (False, "date"),
    "completed": (False, "date"),
    "group": (False, "str"),
    "links": (False, "list"),
}

# prose sections a human or an agent may rewrite; the decision log is not one
# of them - it only ever grows, through `trail log`.
SECTIONS = {
    "goal": "Goal", "scope": "Out of Scope", "out-of-scope": "Out of Scope",
    "steps": "Steps", "questions": "Open Questions",
}
INSTALL_ROOT = Path(__file__).resolve().parent.parent

