#!/usr/bin/env python3
"""trail - a task ledger that lives in your repo.

Single file, standard library only, Python 3.9+.
The point is not the task list; it is the decision log inside each task.
"""
from __future__ import annotations

import argparse
import contextlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import date, datetime
from pathlib import Path

try:
    import fcntl
except ImportError:      # Windows: no advisory locks, writes stay unserialised
    fcntl = None

VERSION = "0.1.0"
STATUSES = ["open", "active", "blocked", "done"]
# prose sections a human or an agent may rewrite; the decision log is not one
# of them - it only ever grows, through `trail log`.
SECTIONS = {
    "goal": "Goal", "scope": "Out of Scope", "out-of-scope": "Out of Scope",
    "plan": "Plan", "questions": "Open Questions",
}
INSTALL_ROOT = Path(__file__).resolve().parent.parent

# Where each agent reads project skills from. Claude Code does NOT read
# .agents/skills/; the others do. Verified against the vendors' docs, not guessed.
AGENT_SKILL_PATHS = {
    "claude": ".claude/skills/trail/SKILL.md",
    "codex": ".agents/skills/trail/SKILL.md",
    "cursor": ".agents/skills/trail/SKILL.md",
    "gemini": ".agents/skills/trail/SKILL.md",
}
AGENT_MARKERS = {
    "claude": ".claude",
    "codex": ".codex",
    "cursor": ".cursor",
    "gemini": ".gemini",
}

BACKLOG_HEADER = (
    "# Backlog\n\nSmall items, no ceremony. Promote with `trail start <slug>` "
    "and delete the line.\n\n"
)

DEFAULTS = {
    "backlog": ".trail/backlog.md",
    "dir": ".trail/tasks",
    # legacy: closing no longer moves anything. Readers still load this directory
    # when a repo initialised by an older trail has one; nothing writes to it.
    "archive": ".trail/archive",
    "template": ".trail/_template.md",
    "stale_days": 7,
}


class TrailError(Exception):
    pass


# --------------------------------------------------------------------------
# tiny YAML subset - serves both config.yml and task frontmatter
# Supports: `key: scalar`, `key:` / `key: []` followed by `- item` lines,
# and `# comments`. A key with no value is read as an empty list; the only
# schema has no list keys left, so that ambiguity costs nothing.
# --------------------------------------------------------------------------

_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$")


def _scalar(s: str) -> str:
    """Strip a trailing ` # comment`, then surrounding quotes."""
    s = s.strip()
    if s[:1] in "\"'":
        if len(s) >= 2 and s[-1] == s[0]:
            inner = s[1:-1]
            return inner.replace('\\"', '"').replace("\\\\", "\\") if s[0] == '"' else inner
        return s
    return re.sub(r"\s+#.*$", "", s).strip()


def yaml_quote(s: str) -> str:
    """Always quote on write. Titles carry colons ("Report: pivot matrix") and a
    bare colon makes the whole frontmatter invalid YAML - which is how two of the
    five files in the first real ledger became unreadable to every other tool."""
    return '"%s"' % str(s).replace("\\", "\\\\").replace('"', '\\"')


def parse_yaml(text: str) -> dict:
    data: dict = {}
    key = None
    for raw in text.splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("- ") and key is not None and isinstance(data.get(key), list):
            data[key].append(_scalar(stripped[2:]))
            continue
        m = _KEY_RE.match(line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val.startswith("#"):
            val = ""
        val = _scalar(val)
        data[key] = [] if val in ("", "[]") else val
    return data


# --------------------------------------------------------------------------
# frontmatter: read is lossy, write is surgical (never reserialize)
# --------------------------------------------------------------------------

def fm_bounds(text: str):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 3)
    if end == -1:
        return None
    return 4, end + 1


def parse_fm(text: str) -> dict:
    b = fm_bounds(text)
    return parse_yaml(text[b[0]:b[1]]) if b else {}


def set_field(text: str, key: str, value) -> str:
    """Replace one frontmatter value in place. Everything else is untouched."""
    b = fm_bounds(text)
    if not b:
        raise TrailError("file has no frontmatter")
    start, end = b
    block = text[start:end]
    pat = re.compile(r"^(" + re.escape(key) + r":)([^\n]*)$", re.M)
    if pat.search(block):
        block = pat.sub(lambda m: "%s %s" % (m.group(1), value), block, count=1)
    else:
        block = block + "%s: %s\n" % (key, value)
    return text[:start] + block + text[end:]


def set_list_field(text: str, key: str, items) -> str:
    """Replace a list-valued frontmatter key. Same surgical contract as
    set_field: nothing else in the block is reserialized."""
    b = fm_bounds(text)
    if not b:
        raise TrailError("file has no frontmatter")
    start, end = b
    block = text[start:end]
    rendered = ("%s: []\n" % key) if not items else (
        "%s:\n" % key + "".join("  - %s\n" % i for i in items))
    pat = re.compile(r"^" + re.escape(key) + r":[^\n]*\n(?:[ \t]*-[^\n]*\n)*", re.M)
    block = pat.sub(rendered, block, count=1) if pat.search(block) else block + rendered
    return text[:start] + block + text[end:]


# --------------------------------------------------------------------------
# serialised writes
# --------------------------------------------------------------------------

@contextlib.contextmanager
def ledger_lock(root: Path):
    """One advisory lock for the whole ledger. Contention is a non-issue here and a
    single lock is the only shape that also covers writes touching two files."""
    if fcntl is None:
        yield
        return
    path = root / ".trail" / ".lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def update_task(root: Path, task: dict, fn) -> str:
    """Re-read under the lock, transform, replace atomically.

    Every writer used to transform the copy loaded before the command started and
    write the whole file back. Fifty concurrent `log`s landed forty entries - and
    reported fifty successes. Locking the write alone does not help: the read has to
    be inside the lock too, or one process still overwrites what the other appended."""
    with ledger_lock(root):
        text = task["path"].read_text("utf-8")
        new = fn(text)
        tmp = task["path"].with_name(task["path"].name + ".tmp")
        tmp.write_text(new, "utf-8")
        os.replace(str(tmp), str(task["path"]))
    task["text"] = new
    return new


# --------------------------------------------------------------------------
# markdown sections
# --------------------------------------------------------------------------

def section_bounds(text: str, heading: str):
    m = re.search(r"^##\s+" + re.escape(heading) + r"\s*$", text, re.M)
    if not m:
        return None
    start = min(m.end() + 1, len(text))
    nxt = re.search(r"^##\s+", text[start:], re.M)
    end = start + nxt.start() if nxt else len(text)
    return start, end


def get_section(text: str, heading: str) -> str:
    b = section_bounds(text, heading)
    if not b:
        return ""
    body = text[b[0]:b[1]]
    keep = [l for l in body.splitlines() if not l.strip().startswith("<!--")]
    return "\n".join(keep).strip()


def set_section(text: str, heading: str, body: str, create: bool = False) -> str:
    b = section_bounds(text, heading)
    if not b:
        if not create:
            raise TrailError("no '## %s' section" % heading)
        return text.rstrip() + "\n\n## %s\n%s\n" % (heading, body.rstrip())
    return text[:b[0]] + body.rstrip() + "\n\n" + text[b[1]:]


def append_section(text: str, heading: str, line: str, create: bool = False) -> str:
    body = get_section(text, heading)
    body = (body + "\n" + line) if body else line
    return set_section(text, heading, body, create=create)


CHECKBOX_RE = re.compile(r"^\s*-\s+\[(.)\]", re.M)


def plan_progress(text: str):
    """(verified, total) over `## Plan` checkboxes, or None when there are none.
    `[-]` is cancelled: resolved, so it leaves the denominator rather than
    sitting there as work that will never be done."""
    marks = [m.group(1) for m in CHECKBOX_RE.finditer(get_section(text, "Plan"))]
    live = [c for c in marks if c != "-"]
    if not live:
        return None
    return sum(1 for c in live if c in "xX"), len(live)


def next_plan_item(text: str) -> str:
    """The first unfinished plan line - the one thing 'where was I' really asks."""
    for line in get_section(text, "Plan").splitlines():
        m = CHECKBOX_RE.match(line)
        if m and m.group(1) not in "xX-":
            return line.strip()
    return ""


def decision_entries(text: str) -> list:
    """[(title, [body lines])]. An entry is a top-level `- ` bullet; its `why:` and
    `dropped:` are indented under it, so the title alone is printable."""
    out = []
    for line in get_section(text, "Decision Log").splitlines():
        if not line.strip():
            continue
        if line.startswith("- "):
            out.append((line, []))
        elif out:
            out[-1][1].append(line)
    return out


# --------------------------------------------------------------------------
# colour - off when piped, off under NO_COLOR
# --------------------------------------------------------------------------

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_CODES = {"head": "1;4", "dim": "2", "id": "36", "open": "34", "active": "1;32",
          "blocked": "31", "done": "2;32", "warn": "33", "label": "1;36"}


def c(s: str, key: str) -> str:
    if not _COLOR or key not in _CODES:
        return s
    return "\033[%sm%s\033[0m" % (_CODES[key], s)


def pad(s: str, w: int, key: str = None) -> str:
    """Pad first, colour second - escape codes must not count toward the width."""
    return c("%-*s" % (w, s), key) if key else "%-*s" % (w, s)


# --------------------------------------------------------------------------
# repo / config / tasks
# --------------------------------------------------------------------------

def find_root(start: Path = None) -> Path:
    p = (start or Path.cwd()).resolve()
    for d in [p] + list(p.parents):
        if (d / ".trail").is_dir():
            return d
        if (d / ".git").exists():
            return d    # repo boundary: a nested repo must not reach the outer ledger
    return p


def load_config(root: Path) -> dict:
    cfg = dict(DEFAULTS)
    f = root / ".trail" / "config.yml"
    if f.is_file():
        for k, v in parse_yaml(f.read_text("utf-8")).items():
            if k in cfg and not isinstance(v, list):
                cfg[k] = v
    raw = str(cfg["stale_days"]).strip()
    cfg["stale_days"] = int(raw) if raw.isdigit() else DEFAULTS["stale_days"]
    return cfg


def age_days(ts: float) -> int:
    return int((datetime.now() - datetime.fromtimestamp(ts)).total_seconds() // 86400)


def load_tasks(root: Path, cfg: dict, archived: bool = False) -> list:
    dirs = [root / cfg["dir"]]
    if archived:
        dirs.append(root / cfg["archive"])
    out = []
    for d in dirs:
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.md")):
            if f.name.startswith("_"):
                continue
            text = f.read_text("utf-8")
            fm = parse_fm(text)

            def s(key, fallback):
                v = fm.get(key)
                return v if isinstance(v, str) and v else fallback

            out.append({
                "path": f,
                "text": text,
                "fm": fm,
                "id": s("id", f.stem),
                "title": s("title", f.stem),
                "level": s("level", "T1"),
                "status": s("status", "open"),
                "group": s("group", ""),
                "started": s("started", ""),
                "links": fm.get("links") if isinstance(fm.get("links"), list) else [],
                "mtime": f.stat().st_mtime,
                "archived": d.name == Path(cfg["archive"]).name,
            })
    return out


def work_order(tasks: list):
    """Sort key: status, then id. Never mtime - the file you touched last is not
    the work that comes first. Ordering between related tasks belongs in the slug
    (`auth-1-provider`, `auth-2-session`), so `id` carries it for free."""
    order = {s: i for i, s in enumerate(STATUSES)}
    return lambda t: (order.get(t["status"], 9), t["id"])


def resolve_task(tasks: list, ident: str = None, optional: bool = False):
    """The implicit target is whatever is in progress. `blocked` counts: a task you
    parked on a dependency is still the one you are on, and refusing to hand it off
    or close it was a dead end. `optional` returns None when nothing is in progress -
    it never hides ambiguity, which is a different problem with a different answer."""
    if ident:
        for t in tasks:
            if t["id"] == ident or t["path"].stem == ident:
                return t
        raise TrailError("no such task: %s" % ident)
    for wanted in ("active", "blocked"):
        cand = [t for t in tasks if t["status"] == wanted]
        if len(cand) == 1:
            return cand[0]
        if cand:
            raise TrailError("more than one %s task, pass --task: %s"
                             % (wanted, ", ".join(t["id"] for t in cand)))
    if optional:
        return None
    raise TrailError("nothing in progress. Pick a task up with 'trail resume <slug>' "
                     "(or 'trail start <slug>'), or pass --task.")


# --------------------------------------------------------------------------
# git signal: did code change more recently than the task file?
# --------------------------------------------------------------------------

def code_newer_than(root: Path, ts: float) -> bool:
    try:
        r = subprocess.run(
            ["git", "-C", str(root), "diff", "--name-only", "HEAD"],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0:
            return False
        names = [n.strip() for n in r.stdout.splitlines() if n.strip()]
    except Exception:
        return False
    for n in names:
        if n.startswith(".trail/"):
            continue
        try:
            if (root / n).stat().st_mtime > ts:
                return True
        except OSError:
            continue
    return False


def missing_scaffold(root: Path, cfg: dict) -> list:
    """Files `init` would create that this repo does not have. A repo initialised by
    an older trail is not broken - both files are also created lazily on first write -
    but the feature stays invisible until someone re-runs init."""
    return [cfg[k] for k in ("backlog",) if not (root / cfg[k]).exists()]


def nudges(root: Path, cfg: dict, tasks: list) -> list:
    out = []
    active = [t for t in tasks if t["status"] == "active"]
    if len(active) > 1:
        out.append("%d tasks are active (%s). Every writer now needs --task, and "
                   "status is that many contexts at once. Park the rest with "
                   "'trail set status open --task <id>'."
                   % (len(active), ", ".join(t["id"] for t in active)))
    for t in tasks:
        if t["status"] not in ("active", "blocked"):
            continue
        age = age_days(t["mtime"])
        if age >= cfg["stale_days"]:
            out.append("%s: untouched for %s days. Still active? Close it or carry on." % (t["id"], age))
        elif code_newer_than(root, t["mtime"]):
            out.append("%s: code moved, the file did not. If a decision was made, "
                       "'trail log'; if it was a finding, 'trail note'; if neither, "
                       "ignore this." % t["id"])
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def set_config_key(path: Path, key: str, value: str) -> None:
    """Rewrite one `key: value` line in config.yml, keeping comments and order."""
    lines = path.read_text("utf-8").splitlines()
    for i, ln in enumerate(lines):
        m = _KEY_RE.match(ln)
        if m and m.group(1) == key:
            comment = ln.split("#", 1)
            lines[i] = "%s: %s%s" % (key, value, "  #" + comment[1] if len(comment) > 1 else "")
            break
    else:
        lines.append("%s: %s" % (key, value))
    path.write_text("\n".join(lines) + "\n", "utf-8")


def cmd_init(args) -> int:
    root = Path.cwd().resolve()
    if (root / ".git").exists() is False:
        print("warning: this does not look like a git repository", file=sys.stderr)
    made = []

    for sub in ("tasks",):
        d = root / ".trail" / sub
        d.mkdir(parents=True, exist_ok=True)
        keep = d / ".gitkeep"
        if not keep.exists():
            keep.write_text("", "utf-8")

    stale = []

    def copy(src: Path, dst: Path, shipped: bool = False):
        if dst.exists():
            # Only SKILL.md is shipped content; config.yml and _template.md are
            # meant to be edited, so drift there is the point, not a problem.
            if shipped and src.read_bytes() != dst.read_bytes():
                if args.force:
                    shutil.copyfile(src, dst)
                    made.append(str(dst.relative_to(root)) + " (refreshed)")
                else:
                    stale.append(str(dst.relative_to(root)))
            return
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        made.append(str(dst.relative_to(root)))

    conf = root / ".trail" / "config.yml"
    copy(INSTALL_ROOT / "templates" / "config.yml", conf)

    cfg = load_config(root)
    copy(INSTALL_ROOT / "templates" / "_template.md", root / ".trail" / "_template.md")
    # `.agents/skills` is a destination this tool writes to, so a repo that already
    # has one is already an agent repo - detecting only the per-vendor markers sent
    # those repos back to the Claude default.
    agents = args.agent or [a for a, m in AGENT_MARKERS.items() if (root / m).is_dir()]
    if not args.agent and (root / ".agents" / "skills").is_dir():
        agents.append("codex")   # any of codex/cursor/gemini resolves to .agents/skills
    if "all" in agents:
        agents = list(AGENT_SKILL_PATHS)
    if not agents:
        agents = ["claude"]
    src = INSTALL_ROOT / "skills" / "trail" / "SKILL.md"
    for dest in sorted({AGENT_SKILL_PATHS[a] for a in agents}):
        copy(src, root / dest, shipped=True)

    ign = root / ".trail" / ".gitignore"
    if not ign.exists():
        ign.write_text(".lock\n", "utf-8")   # the advisory lock is machine state
        made.append(".trail/.gitignore")

    bl = root / cfg["backlog"]
    if not bl.exists():
        bl.parent.mkdir(parents=True, exist_ok=True)
        bl.write_text(BACKLOG_HEADER, "utf-8")
        made.append(cfg["backlog"])


    print("ready: %s" % root)
    for m in made:
        print("  + %s" % m)
    if not made:
        print("  (everything already in place)")
    for s in stale:
        print("  ! %s differs from the installed copy - 'trail init --force' overwrites it" % s)
    print("\nnext: trail start <slug> [T1|T2]")
    print("note: .trail/ is committed by default. Add it to .gitignore if you'd rather not.")
    return 0


def slugify(s: str) -> str:
    s = s.lower().strip()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-")


def cmd_start(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tpl = root / cfg["template"]
    if not tpl.is_file():
        raise TrailError("no template at %s  (did you run 'trail init'?)" % tpl)

    slug = slugify(args.slug)
    if not slug:
        raise TrailError("invalid slug")
    dest = root / cfg["dir"] / (slug + ".md")

    level = (args.level or "T1").upper()
    if level not in ("T1", "T2"):
        raise TrailError(
            "T0 has no task file. If you are doing it now, write nothing;\n"
            "       if you are deferring it, 'trail backlog \"...\"' (%s);\n"
            "       if it needs a status and a handoff, it is at least T1."
            % cfg["backlog"])

    values = {
        "id": slug,
        "title": args.title or slug,
        "level": level,
        "status": args.status,
        "date": date.today().isoformat(),
    }
    text = tpl.read_text("utf-8")
    # unknown placeholders are left untouched on purpose
    for k, v in values.items():
        text = text.replace("{{%s}}" % k, v)
    # quote after substitution: the H1 keeps the raw title, the frontmatter is valid
    text = set_field(text, "title", yaml_quote(values["title"]))
    if args.group:
        text = set_field(text, "group", slugify(args.group))

    dest.parent.mkdir(parents=True, exist_ok=True)
    # Write the file whole, then make it visible in one step. os.link is the
    # create-only-if-absent counterpart to update_task's os.replace: it refuses to
    # clobber, and no other command can ever observe the task half-written.
    # `open(dest, "x")` closed the start/start race but left that second gap - the
    # empty file was already visible, so a concurrent `log` replaced it and start's
    # own write landed on an unlinked inode, with both commands reporting success.
    tmp = dest.with_name("%s.%d.tmp" % (dest.name, os.getpid()))
    tmp.write_text(text, "utf-8")
    try:
        os.link(str(tmp), str(dest))
    except FileExistsError:
        raise TrailError("already exists: %s" % dest.relative_to(root))
    finally:
        tmp.unlink()
    print("created: %s" % dest.relative_to(root))
    return 0


SETTABLE = {
    "status": ["open", "active", "blocked"],   # closing is `trail done`
    "level": ["T1", "T2"],
    "title": None,
    "group": None,
}


def cmd_set(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    task = resolve_task(tasks, args.task)
    allowed = SETTABLE[args.field]
    value = args.value
    if args.field in ("status", "level"):
        value = value.lower() if args.field == "status" else value.upper()
    if args.field == "group":
        value = slugify(value)
    if allowed and value not in allowed:
        extra = " (to close, use 'trail done')" if args.field == "status" else ""
        raise TrailError("%s must be one of: %s%s"
                         % (args.field, ", ".join(allowed), extra))
    old = task["fm"].get(args.field) or task.get(args.field) or "-"
    written = yaml_quote(value) if args.field == "title" else value
    update_task(root, task, lambda txt: set_field(txt, args.field, written))
    print("%s: %s %s -> %s" % (task["id"], args.field, old, value or "-"))
    return 0


def cmd_backlog(args) -> int:
    """A sink, not a tracker. No ids, no status, no lifecycle - the only thing it
    guarantees is that an item the user mentioned still exists tomorrow."""
    root = find_root()
    cfg = load_config(root)
    f = root / cfg["backlog"]
    if not args.item:
        if not f.is_file():
            print("backlog is empty")
            return 0
        sys.stdout.write(f.read_text("utf-8"))
        return 0
    if not f.is_file():
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(BACKLOG_HEADER, "utf-8")
    tag = ""
    if not args.untagged:
        # optional: an untagged line is fine when nothing is in progress. Two active
        # tasks is not that case - `log` refuses there, and guessing a tag silently
        # is worse than refusing, because the wrong tag reads as fact later.
        owner = resolve_task(load_tasks(root, cfg), args.task, optional=True)
        if owner:
            tag = " #" + owner["id"]
    with f.open("a", encoding="utf-8") as fh:
        for item in args.item:
            fh.write("- [ ] %s%s\n" % (item.strip(), tag))
    print("%s: +%d%s" % (cfg["backlog"], len(args.item), tag and " (%s)" % tag.strip()))
    return 0


def backlog_count(root: Path, cfg: dict) -> int:
    f = root / cfg["backlog"]
    if not f.is_file():
        return 0
    n = 0
    for l in f.read_text("utf-8").splitlines():
        s = l.strip()
        if not s.startswith("- "):
            continue
        m = CHECKBOX_RE.match(s)
        if m and m.group(1) in "xX-":   # done or cancelled is not a pending item
            continue
        n += 1
    return n


def cmd_link(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    def add(txt):
        links = list(parse_fm(txt).get("links") or [])
        for path in args.path:
            if path not in links:
                links.append(path)
        return set_list_field(txt, "links", links)
    links = parse_fm(update_task(root, task, add)).get("links") or []
    print("%s: links -> %s" % (task["id"], ", ".join(links)))
    return 0


def cmd_write(args) -> int:
    """Replace a prose section from stdin. The alternative - an agent doing a
    literal string replace on the template's comment - fails silently."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    body = sys.stdin.read().strip()
    if not body:
        raise TrailError("empty stdin: pipe the section body in")
    canonical = {v.lower(): v for v in SECTIONS.values()}
    key = args.section.strip().lower()
    heading = SECTIONS.get(key) or canonical.get(key)
    if not heading:
        raise TrailError("section must be one of: %s" % ", ".join(sorted(set(SECTIONS.values()))))
    update_task(root, task, lambda txt: set_section(txt, heading, body, create=True))
    n = len(body.splitlines())
    print("%s: ## %s written (%d line%s)" % (task["id"], heading, n, "" if n == 1 else "s"))
    return 0


def cmd_log(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    entry = "- **%s** · %s" % (date.today().isoformat(), args.text.strip())
    if args.why:
        entry += "\n  - **why:** " + args.why.strip()
    if args.dropped:
        entry += "\n  - **dropped:** " + args.dropped.strip()
    update_task(root, task,
                lambda txt: append_section(txt, "Decision Log", entry, create=True))
    print("%s <- %s" % (task["id"], entry.splitlines()[0]))
    return 0


def cmd_note(args) -> int:
    """`## Notes` has no shape and no rules. It exists because the first real
    ledger pushed measurements and findings into the backlog for want of anywhere
    else, and a section nothing can write to stays empty forever."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    line = "- **%s** · %s" % (date.today().isoformat(), args.text.strip())
    update_task(root, task, lambda txt: append_section(txt, "Notes", line, create=True))
    print("%s <- %s" % (task["id"], line))
    return 0


def cmd_handoff(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    update_task(root, task, lambda txt: set_section(txt, "Status", args.text.strip()))
    print("%s: ## Status updated" % task["id"])
    return 0


def cmd_done(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)

    # The file does not move. The closed task is the most useful one in the
    # ledger - it is the only place that says what was verified and what was
    # left undone - and archiving hid it from every reader by default.
    update_task(root, task, lambda txt: set_field(txt, "status", "done"))
    open_items, done_items = backlog_state(root, cfg, task["id"])

    # A closing report, not a pipeline. Nothing is copied, moved or deleted: the
    # decision log is already permanent where it was written, and the backlog's one
    # promise is that an item the user mentioned is still there tomorrow.
    print("closed:  %s" % task["id"])
    print("status:  %s -> done" % task["status"])
    print("file:    %s (not moved)" % task["path"].relative_to(root))
    print("log:     %d entr%s, kept in the task file"
          % (len(decision_entries(task["text"])),
             "y" if len(decision_entries(task["text"])) == 1 else "ies"))
    pr = plan_progress(task["text"])
    if pr:
        marks = [m.group(1) for m in CHECKBOX_RE.finditer(get_section(task["text"], "Plan"))]
        rest = [("%d unverified [/]" % marks.count("/")) if "/" in marks else "",
                ("%d not started [ ]" % marks.count(" ")) if " " in marks else ""]
        rest = [r for r in rest if r]
        print("plan:    %d/%d verified%s"
              % (pr[0], pr[1], (", " + ", ".join(rest)) if rest else ""))
        if rest:
            print(c("           closing with plan items open - deliberate?", "warn"))
    if open_items or done_items:
        print("backlog: #%s -> %d open, %d done"
              % (task["id"], len(open_items), len(done_items)))
        for item in open_items:
            print(c("           still open: %s" % item, "warn"))
    return 0


def backlog_state(root: Path, cfg: dict, slug: str):
    """(open, done) backlog lines tagged with this task. Read-only on purpose: the
    first close left two deliberate open items behind, and a sink that deletes what
    it holds is not a sink."""
    f = root / cfg["backlog"]
    if not f.is_file():
        return [], []
    tag = re.compile(r"(?:^|\s)#" + re.escape(slug) + r"(?=\s|$)")
    open_items, done_items = [], []
    for line in f.read_text("utf-8").splitlines():
        s = line.strip()
        if not (s.startswith("- ") and tag.search(s)):
            continue    # substring matching counted #auth-1-extra as #auth-1's
        m = CHECKBOX_RE.match(s)
        (done_items if m and m.group(1) in "xX" else open_items).append(s)
    return open_items, done_items


def scope_to_group(tasks: list, args):
    """Narrow the readers to the group being worked on. At forty tasks a full board
    stops compressing context and starts being a project-management surface, which
    is the opposite of what this tool is for.

    Returns (tasks, label). Any explicit filter wins - `--stale 7` asks "what did I
    abandon", and narrowing that to one group answers the wrong question."""
    if getattr(args, "all", False) or any(
            getattr(args, k, None) for k in ("group", "status", "level", "stale")):
        if getattr(args, "group", None):
            g = slugify(args.group)
            return [t for t in tasks if t["group"] == g], "group %s" % g
        return tasks, ""
    groups = {t["group"] for t in tasks if t["status"] == "active" and t["group"]}
    if not groups:
        return tasks, ""          # nothing active, or it carries no group
    return ([t for t in tasks if t["group"] in groups],
            "group " + " + ".join(sorted(groups)))


def cmd_resume(args) -> int:
    """Pick a task up again. The skill parks planned tasks as `open`, and every
    writer targets whatever is in progress - so without this the documented way to
    start work ('trail set status active') failed with 'no active task'."""
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    task = resolve_task(tasks, args.slug)
    if task["status"] == "done":
        raise TrailError("%s is done. Reopen it first: "
                         "trail set status open --task %s" % (task["id"], task["id"]))
    if task["status"] != "active":
        update_task(root, task, lambda txt: set_field(txt, "status", "active"))
        print("%s: %s -> active" % (task["id"], task["status"]))
    for other in tasks:
        if other["status"] == "active" and other["id"] != task["id"]:
            print(c("also active: %s — park it with 'trail set status open --task %s'"
                    % (other["id"], other["id"]), "warn"))
    args.task = task["id"]
    return cmd_status(args)


def _filter(tasks, args):
    out = tasks
    if getattr(args, "status", None):
        out = [t for t in out if t["status"] == args.status]
    if getattr(args, "level", None):
        out = [t for t in out if t["level"].upper() == args.level.upper()]
    if getattr(args, "stale", None):
        out = [t for t in out if age_days(t["mtime"]) >= args.stale]
    return out


def _as_dict(t):
    return {
        "id": t["id"], "title": t["title"], "level": t["level"],
        "status": t["status"], "group": t["group"],
        "started": t["started"], "links": t["links"],
        "age_days": age_days(t["mtime"]),
        "path": str(t["path"]), "archived": t["archived"],
    }


def cmd_ls(args) -> int:
    root = find_root()
    cfg = load_config(root)
    all_tasks = _filter(load_tasks(root, cfg, archived=args.all), args)
    tasks, scope = scope_to_group(all_tasks, args)
    if not args.all and not getattr(args, "status", None):
        tasks = [t for t in tasks if t["status"] != "done"]
    if args.json:   # same selection as the table: the format must not pick the data
        print(json.dumps([_as_dict(t) for t in tasks], ensure_ascii=False, indent=2))
        return 0
    if not tasks:
        print("no tasks")
        return 0
    if scope:
        print(c("%s · %d of %d tasks (--all for every task)"
                % (scope, len(tasks), len(all_tasks)), "dim"))
    tasks.sort(key=work_order(tasks))
    w = max(len(t["id"]) for t in tasks)
    groups = {}
    for t in tasks:
        groups.setdefault(t["group"], []).append(t)
    grouped = len(groups) > 1   # one group needs no header: the scope line says it
    ind = "  " if grouped else ""
    print(c("%s%s  %-4s  %-8s  %5s  %5s  %s"
            % (ind, pad("ID", w), "LVL", "STATUS", "AGE", "PLAN", "TITLE"), "head"))
    for g, items in sorted(groups.items(), key=lambda kv: (kv[0] == "", kv[0])):
        if grouped:
            print(c(g or "(ungrouped)", "id"))
        for t in items:
            pr = plan_progress(t["text"])
            print("%s%s  %-4s  %s  %4dd  %5s  %s" % (
                ind, pad(t["id"], w, "id"), t["level"],
                pad(t["status"], 8, t["status"]), age_days(t["mtime"]),
                "%d/%d" % pr if pr else "-", t["title"]))
    return 0


def cmd_board(args) -> int:
    root = find_root()
    cfg = load_config(root)
    all_tasks = load_tasks(root, cfg, archived=args.all)
    tasks, scope = scope_to_group(all_tasks, args)
    tasks.sort(key=work_order(tasks))
    if scope:
        print(c("%s · %d of %d tasks (--all for every task)"
                % (scope, len(tasks), len(all_tasks)), "dim"))
    cols = [(s, [t["id"] for t in tasks if t["status"] == s]) for s in STATUSES]
    # width follows the ids; truncating them mid-word was the fastest way to make
    # the board unreadable ("report-3-rapor-say")
    width = max([len(i) for _, ids in cols for i in ids] + [len("blocked (0)")])
    print("  ".join(c(pad("%s (%d)" % (s, len(ids)), width), s) for s, ids in cols))
    print("  ".join("-" * width for _ in cols))
    depth = max([len(ids) for _, ids in cols] + [0])
    for i in range(depth):
        row = []
        for _, ids in cols:
            row.append(pad(ids[i] if i < len(ids) else "", width))
        print("  ".join(row).rstrip())
    if depth == 0:
        print("(empty)")
    return 0


def cmd_show(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg, archived=True), args.task)
    if args.json:
        d = _as_dict(task)
        d["goal"] = get_section(task["text"], "Goal")
        d["status_note"] = get_section(task["text"], "Status")
        d["decisions"] = [l for l in get_section(task["text"], "Decision Log").splitlines() if l.strip()]
        print(json.dumps(d, ensure_ascii=False, indent=2))
        return 0
    sys.stdout.write(task["text"])
    return 0


SECTION_RE = re.compile(r"^##\s+(.+?)\s*$", re.M)


def search_units(text: str):
    """(heading, [lines]) per searchable unit. The decision log's unit is the whole
    entry: `why:` and `dropped:` are indented under a title line, so a line-based
    match - what `rg` gives you - reports the rejected alternative without the
    decision it belongs to. Every other section is one line per item. Headings are
    read off the file rather than hardcoded; task files are editable by hand and the
    template is configurable."""
    for m in SECTION_RE.finditer(text):
        head = m.group(1)
        if head == "Decision Log":
            for title, body in decision_entries(text):
                yield head, [title] + body
        else:
            for line in get_section(text, head).splitlines():
                if line.strip():
                    yield head, [line]


def cmd_search(args) -> int:
    root = find_root()
    cfg = load_config(root)
    q = args.query.lower()
    # the archive is searched too: "did we already reject this?" is exactly the
    # question a closed task answers, and a default that hides it answers it wrong
    tasks = sorted(load_tasks(root, cfg, archived=True), key=lambda t: t["id"])
    hits = seen = 0
    for t in tasks:
        found = [(h, lines) for h, lines in search_units(t["text"])
                 if q in "\n".join(lines).lower()]
        if not found:
            continue
        seen += 1
        hits += len(found)
        where = "%s%s" % (t["status"], ", archived" if t["archived"] else "")
        for head, lines in found:
            print("%s %s %s" % (c(t["id"], "id"), c("(%s)" % where, t["status"]),
                                c("· " + head, "dim")))
            for line in lines:
                print("  " + line)
            print("")
    if not hits:
        print("no match for %r" % args.query)
        return 0
    print(c("%d hit%s in %d task%s"
            % (hits, "" if hits == 1 else "s", seen, "" if seen == 1 else "s"), "dim"))
    return 0


def cmd_status(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    live = ([resolve_task(tasks, args.task)] if args.task
            else [t for t in tasks if t["status"] in ("active", "blocked")])
    ns = nudges(root, cfg, tasks)
    gap = missing_scaffold(root, cfg)
    if gap:
        ns.append("this repo predates part of the scaffold (%s) - run 'trail init'"
                  % ", ".join(gap))
    n_backlog = backlog_count(root, cfg)

    if args.json:
        print(json.dumps({
            "root": str(root),
            "tasks": [_as_dict(t) for t in live],
            "backlog_items": n_backlog,
            "nudges": ns,
        }, ensure_ascii=False, indent=2))
        return 0

    # --inject feeds a hook or an agent: never colour it, never pad it
    lab = (lambda s: s) if args.inject else (lambda s: c(s, "label"))
    lines = []
    for t in live:
        # one block per label, blank line between them: these are long lines and
        # they run together otherwise
        head = "%s %s (%s, %s" % (lab("Task:"), t["id"], t["level"], t["status"])
        if t["group"]:
            head += ", group %s" % t["group"]
        blocks = [head + ", started %s)" % t["started"]]
        goal = get_section(t["text"], "Goal")
        if goal:
            blocks.append(lab("Goal:") + " " + goal.replace("\n", " "))
        pr = plan_progress(t["text"])
        if pr:
            blocks.append(lab("Plan:") + " %d/%d verified" % pr)
            nxt = next_plan_item(t["text"])
            if nxt:
                blocks.append(lab("Next:") + " " + nxt)
        st = get_section(t["text"], "Status")
        if st:
            blocks.append(lab("Status:") + " " + st.replace("\n", " "))
        # the boundary is short and it is the one section that stops the wrong work
        # being done; leaving it out of the digest was how scope got lost
        scope = get_section(t["text"], "Out of Scope")
        if scope:
            blocks.append(lab("Out of scope:") + "\n" + scope)
        if t["links"]:
            blocks.append(lab("Links:") + " " + ", ".join(t["links"]))
        # titles only: printing five full entries put ~4k characters of prose in
        # front of every session, and nobody read it. `--full` still can.
        dec = decision_entries(t["text"])
        if dec:
            # keep the target: a bare `--full` re-selects active/blocked tasks, so the
            # task being read here would vanish from the very command that explains it
            more = "trail status%s --full" % (" --task " + t["id"] if args.task else "")
            block = [lab("Recent decisions") + " (%s for the reasons):" % more]
            for title, body in dec[-5:]:
                block.append("  " + title)
                if args.full:
                    block.extend("  " + b for b in body)
            blocks.append("\n".join(block))
        # A digest must not hide that it is one. Counts, not content: a new session
        # cannot ask for what it does not know exists.
        def entries(sec):
            body = get_section(t["text"], sec)
            bullets = [l for l in body.splitlines() if l.strip().startswith("- ")]
            return bullets or [l for l in body.splitlines() if l.strip()]
        inv = []
        for sec in ("Notes", "Open Questions"):
            n = len(entries(sec))
            if n:
                inv.append("%s %d" % (sec, n))
        if len(dec) > 5:
            inv.append("Decisions %d (last 5 above)" % len(dec))
        if inv:
            blocks.append("%s %s — trail show %s"
                          % (lab("Not shown:"), " · ".join(inv), t["id"]))
        lines.append("\n\n".join(blocks))
        lines.append("")
    if n_backlog:
        lines.append("backlog: %d open item%s (trail backlog)"
                     % (n_backlog, "" if n_backlog == 1 else "s"))
        lines.append("")
    if ns:
        lines.append(lab("Nudges:"))
        lines.extend("  - " + n for n in ns)
        lines.append("")
    if not live and not ns and not n_backlog:
        lines.append("No active task.")

    if args.inject:
        if not live and not ns and not n_backlog:
            return 0
        lines.append("Write it the moment you decide: trail log \"<decision>\" --why ... --dropped ...")
        print("===BEGIN TRAIL===")
        print("\n".join(lines).strip())
        print("===END TRAIL===")
    else:
        print("\n".join(lines).strip())
    return 0


# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="trail", description="task ledger for repos",
        epilog="--no-color (any position) or NO_COLOR=1 turns colour off; "
               "it is off already when stdout is not a terminal.")
    p.add_argument("--version", action="version", version="trail " + VERSION)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("init", help="set up .trail/ in this repo")
    s.add_argument("--force", action="store_true",
                   help="overwrite a SKILL.md that has drifted from the installed copy")
    s.add_argument("--agent", action="append",
                   choices=sorted(AGENT_SKILL_PATHS) + ["all"],
                   help="where to write SKILL.md (default: detect the agents this repo uses)")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("start", help="new task file")
    s.add_argument("slug")
    s.add_argument("level", nargs="?", help="T1 (default) or T2; T0 has no file")
    s.add_argument("--title")
    s.add_argument("--status", choices=["open", "active", "blocked"], default="active",
                   help="use 'open' when planning in bulk; default active")
    s.add_argument("--group", help="shared label for tasks from one plan run")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("set", help="change a frontmatter field")
    s.add_argument("field", choices=sorted(SETTABLE))
    s.add_argument("value")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("backlog", help="small items; no args prints the list")
    s.add_argument("--untagged", action="store_true",
                   help="do not tag the item with the active task")
    s.add_argument("--task", help="tag with this task instead of the active one")
    s.add_argument("item", nargs="*")
    s.set_defaults(fn=cmd_backlog)

    s = sub.add_parser("link", help="attach a repo path (code or doc) to a task")
    s.add_argument("path", nargs="+")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_link)

    s = sub.add_parser("write", help="write a prose section from stdin")
    s.add_argument("section", help=", ".join(sorted(SECTIONS)))
    s.add_argument("--task")
    s.set_defaults(fn=cmd_write)

    s = sub.add_parser("log", help="append one line to the decision log")
    s.add_argument("text")
    s.add_argument("--why")
    s.add_argument("--dropped")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("note", help="append a dated line to ## Notes")
    s.add_argument("text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_note)

    s = sub.add_parser("handoff", help="rewrite the ## Status section")
    s.add_argument("text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_handoff)

    s = sub.add_parser("done", help="close a task and report what is around it")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_done)

    s = sub.add_parser("ls", help="task list")
    s.add_argument("--status", choices=STATUSES)
    s.add_argument("--level")
    s.add_argument("--stale", type=int, metavar="N")
    s.add_argument("--group", help="one group instead of the active task's")
    s.add_argument("--all", action="store_true",
                   help="every task and every group, plus a legacy archive")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("board", help="terminal kanban")
    s.add_argument("--group", help="one group instead of the active task's")
    s.add_argument("--all", action="store_true",
                   help="every task and every group, plus a legacy archive")
    s.set_defaults(fn=cmd_board)

    s = sub.add_parser("show", help="one task in full")
    s.add_argument("task", nargs="?")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("search", help="find a decision, note or plan item by text")
    s.add_argument("query")
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("status", help="what is in progress + nudges")
    s.add_argument("--task", help="one task by slug, whatever its status")
    s.add_argument("--full", action="store_true",
                   help="print the why/dropped bodies, not just decision titles")
    s.add_argument("--inject", action="store_true", help="wrap in delimiters for context injection")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("resume", help="pick a task up again and print its status")
    s.add_argument("slug")
    s.set_defaults(fn=cmd_resume, task=None, full=False, inject=False, json=False)
    return p


def main(argv=None) -> int:
    global _COLOR
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--no-color" in argv:          # accepted anywhere, so no subparser plumbing
        argv = [a for a in argv if a != "--no-color"]
        _COLOR = False
    if os.environ.get("TRAIL_DISABLED") == "1":
        return 0
    args = build_parser().parse_args(argv)
    if not getattr(args, "fn", None):
        build_parser().print_help()
        return 1
    try:
        return args.fn(args)
    except TrailError as e:
        print("trail: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
