    "codex": ".agents/skills",
    "cursor": ".agents/skills",
    "gemini": ".agents/skills",
}
# Two entry points, split by what the user is doing rather than by what the model
# infers: `/trail` resumes and works, `/trail-plan` turns a document into tasks.
# Each file is complete for its own scenario, so a session loads one of them.
SKILLS = ("trail", "trail-plan")
AGENT_MARKERS = {
    "claude": ".claude",
    "codex": ".codex",
    "cursor": ".cursor",
    "gemini": ".gemini",
}

BACKLOG_HEADER = (
    "# Backlog\n\nSmall items, no ceremony. Promote with `trail start <slug>` "
    "and delete the line.\n\n"
)

DEFAULTS = {
    "backlog": ".trail/backlog.md",
    "dir": ".trail/tasks",
    # legacy: closing no longer moves anything. Readers still load this directory
    # when a repo initialised by an older trail has one; nothing writes to it.
    "archive": ".trail/archive",
    "template": ".trail/_template.md",
    "stale_days": 7,
}


class TrailError(Exception):
    pass


class Unchanged(Exception):
    """The requested end state already holds. Not an error, and nothing is
    written - raised from inside a mutation so the write never happens."""


# --------------------------------------------------------------------------
# tiny YAML subset - serves both config.yml and task frontmatter
# Supports: `key: scalar`, `key:` / `key: []` followed by `- item` lines,
# and `# comments`. A key with no value is read as an empty list; the only
# schema has no list keys left, so that ambiguity costs nothing.
# --------------------------------------------------------------------------

_KEY_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$")


def _scalar(s: str) -> str:
    """Strip a trailing ` # comment`, then surrounding quotes."""
    s = s.strip()
    if s[:1] in "\"'":
        if len(s) >= 2 and s[-1] == s[0]:
            inner = s[1:-1]
            return inner.replace('\\"', '"').replace("\\\\", "\\") if s[0] == '"' else inner
        return s
    return re.sub(r"\s+#.*$", "", s).strip()


def yaml_quote(s: str) -> str:
    """Always quote on write. Titles carry colons ("Report: pivot matrix") and a
    bare colon makes the whole frontmatter invalid YAML - which is how two of the
    five files in the first real ledger became unreadable to every other tool."""
    return '"%s"' % str(s).replace("\\", "\\\\").replace('"', '\\"')


def parse_yaml(text: str) -> dict:
    data: dict = {}
    key = None
    for raw in text.splitlines():
        line = raw.rstrip()
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("- ") and key is not None and isinstance(data.get(key), list):
            data[key].append(_scalar(stripped[2:]))
            continue
        m = _KEY_RE.match(line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val.startswith("#"):
            val = ""
        val = _scalar(val)
        data[key] = [] if val in ("", "[]") else val
    return data


# --------------------------------------------------------------------------
# frontmatter: read is lossy, write is surgical (never reserialize)
# --------------------------------------------------------------------------

def fm_bounds(text: str):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---\n", 3)
    if end == -1:
        return None
    return 4, end + 1


def parse_fm(text: str) -> dict:
    b = fm_bounds(text)
    return parse_yaml(text[b[0]:b[1]]) if b else {}


def set_field(text: str, key: str, value) -> str:
    """Replace one frontmatter value in place. Everything else is untouched."""
    b = fm_bounds(text)
    if not b:
        raise TrailError("file has no frontmatter")
    start, end = b
    block = text[start:end]
    # an empty value is `key:`, the way the template writes it - not `key: ` with a
    # trailing space for every diff to trip over
    line = "%s: %s" % (key, value) if value != "" else "%s:" % key
    pat = re.compile(r"^" + re.escape(key) + r":[^\n]*$", re.M)
    if pat.search(block):
        block = pat.sub(lambda m: line, block, count=1)
    else:
        block = block + line + "\n"
    return text[:start] + block + text[end:]


def set_list_field(text: str, key: str, items) -> str:
    """Replace a list-valued frontmatter key. Same surgical contract as
    set_field: nothing else in the block is reserialized."""
    b = fm_bounds(text)
    if not b:
        raise TrailError("file has no frontmatter")
    start, end = b
    block = text[start:end]
    rendered = ("%s: []\n" % key) if not items else (
        "%s:\n" % key + "".join("  - %s\n" % i for i in items))
    pat = re.compile(r"^" + re.escape(key) + r":[^\n]*\n(?:[ \t]*-[^\n]*\n)*", re.M)
    block = pat.sub(rendered, block, count=1) if pat.search(block) else block + rendered
    return text[:start] + block + text[end:]


def change_status(text: str, status: str, today: str, new: bool = False) -> str:
    """The task-level counterpart of transition(): a status and the dates it implies,
    in one place. `started` is the first day the task became active, so only a move
    *into* active writes it, and only while it is empty. `completed` is the day it
    closed: the move into done writes it while empty, the move out clears it. An
    already-active task with no `started`, or an already-done one with no
    `completed`, stays that way - the real day is unknown and today would be false.
    `new` is `trail start`: the file is being made, so whatever the template put in
    `status:` or `started:` is not history."""
    fm = {} if new else parse_fm(text)

    def val(key):
        v = fm.get(key)
        return v if isinstance(v, str) else ""

    was = val("status")
    text = set_field(text, "status", status)
    if status == ACTIVE and was != ACTIVE and not val("started"):
        text = set_field(text, "started", today)
    elif new:
        text = set_field(text, "started", "")
    if status == DONE and was != DONE and not val("completed"):
        text = set_field(text, "completed", today)
    elif was == DONE and status != DONE and val("completed"):
        text = set_field(text, "completed", "")
    return text


# --------------------------------------------------------------------------
# serialised writes
# --------------------------------------------------------------------------

@contextlib.contextmanager
def ledger_lock(root: Path):
    """One advisory lock for the whole ledger. Contention is a non-issue here and a
    single lock is the only shape that also covers writes touching two files."""
    if fcntl is None:
        yield
        return
    path = root / ".trail" / ".lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def update_task(root: Path, task: dict, fn) -> str:
    """Re-read under the lock, transform, replace atomically.

    Every writer used to transform the copy loaded before the command started and
    write the whole file back. Fifty concurrent `log`s landed forty entries - and
    reported fifty successes. Locking the write alone does not help: the read has to
    be inside the lock too, or one process still overwrites what the other appended."""
    with ledger_lock(root):
        text = task["path"].read_text("utf-8")
        new = fn(text)
        tmp = task["path"].with_name(task["path"].name + ".tmp")
        tmp.write_text(new, "utf-8")
        os.replace(str(tmp), str(task["path"]))
    task["text"] = new
    return new


# --------------------------------------------------------------------------
# markdown sections
# --------------------------------------------------------------------------

def section_bounds(text: str, heading: str):
    m = re.search(r"^##\s+" + re.escape(heading) + r"\s*$", text, re.M)
    if not m:
        return None
    start = min(m.end() + 1, len(text))
    nxt = re.search(r"^##\s+", text[start:], re.M)
    end = start + nxt.start() if nxt else len(text)
    return start, end


def get_section(text: str, heading: str) -> str:
    b = section_bounds(text, heading)
    if not b:
        return ""
    body = text[b[0]:b[1]]
    keep = [l for l in body.splitlines() if not l.strip().startswith("<!--")]
    return "\n".join(keep).strip()


def set_section(text: str, heading: str, body: str, create: bool = False) -> str:
    b = section_bounds(text, heading)
    if not b:
        if not create:
            raise TrailError("no '## %s' section" % heading)
        return text.rstrip() + "\n\n## %s\n%s\n" % (heading, body.rstrip())
    return text[:b[0]] + body.rstrip() + "\n\n" + text[b[1]:]


def append_section(text: str, heading: str, line: str, create: bool = False) -> str:
    body = get_section(text, heading)
    body = (body + "\n" + line) if body else line
    return set_section(text, heading, body, create=create)


CHECKBOX_RE = re.compile(r"^\s*-\s+\[(.)\]", re.M)   # backlog lines; steps go through parse_steps


def bullet_entries(text: str, heading: str) -> list:
    """[(title, [body lines])] for a section written as dated bullets. An entry is
    a top-level `- ` bullet with its indented lines under it, so the title alone is
    printable; a free-form line before any bullet is an entry of its own, since a
    section with no rules must not have invisible content."""
    out = []
    for line in get_section(text, heading).splitlines():
        if not line.strip():
            continue
        if line.startswith("- ") or not out:
            out.append((line, []))
        else:
            out[-1][1].append(line)
    return out


def decision_entries(text: str) -> list:
    """The decision log's `why:` and `dropped:` sit indented under a title line."""
    return bullet_entries(text, "Decision Log")


def render_decision(title: str, why, dropped, today: str) -> str:
    """One scannable title line, the reasons as sub-bullets. A reason spanning
    several lines continues indented under its label, which is how the reader
    (`decision_entries`) already groups an entry; blank lines inside a reason are
    dropped, an entry is a block, not an essay."""
    lines = ["- **%s** · %s" % (today, title.strip())]
    for label, body in (("why", why), ("dropped", dropped)):
        rows = [r.rstrip() for r in (body or "").strip().splitlines() if r.strip()]
        if rows:
            lines.append("  - **%s:** %s" % (label, rows[0]))
            lines.extend("    " + r for r in rows[1:])
    return "\n".join(lines)


LOG_LABELS = ("why", "dropped")


def parse_log_stdin(raw: str) -> dict:
    """The stdin form of `trail log`: a line that is exactly `--why` or `--dropped`
    opens that field, everything up to the next label is its body. The labels are
    the flags themselves, so there is nothing new to learn and no prose line looks
    like one. Text before the first label, a label given twice, or no label at all
    is refused - the split has to be deterministic, never guessed."""
    fields, current = {}, None
    for line in raw.splitlines():
        key = line.strip()
        if key.startswith("--") and key[2:] in LOG_LABELS:
            key = key[2:]
            if key in fields:
                raise TrailError("stdin: --%s appears twice" % key)
            fields[key] = []
            current = key
            continue
        if current is None:
            if line.strip():
                raise TrailError("stdin must start with a --why or --dropped line, "
                                 "not with %r" % line.strip()[:40])
            continue
        fields[current].append(line)
    if not fields:
        raise TrailError("stdin: no --why or --dropped line found, nothing to log from it")
    out = {k: "\n".join(v).strip() for k, v in fields.items()}
    for k, v in out.items():
        if not v:
            raise TrailError("stdin: --%s has an empty body" % k)
    return out


# --------------------------------------------------------------------------
# steps - the one part of the Markdown trail parses instead of passing through
#
#   - [/] classify ErrorCode [id:: ap-k4m2] [blocked:: 2026-09-15] [blocked-reason:: no audio file]
#
# The box is progress and nothing else. The bracketed fields are Dataview's inline
# syntax, and the four keys below are the only ones trail owns; they are read from
# anywhere on the line and written back after the text, in the order they already
# had. Everything else - a wikilink, a `[priority:: high]`, a comment - is text and
# comes back byte for byte. A line that is not a step is never touched, and a
# fenced code block is opaque whatever it contains.
# --------------------------------------------------------------------------

STEP_STATES = {" ": "not started", "/": "written, not verified",
               "x": "verified", "-": "cancelled"}
RESOLVED = ("x", "-")
TRAIL_FIELDS = ("id", "completion", "blocked", "blocked-reason")
ID_ALPHABET = "abcdefghijklmnopqrstuvwxyz0123456789"
ITEM_ID_RE = re.compile(r"^[a-z0-9]+-[a-z0-9]{4}$")
# a checkbox is followed by whitespace or the end of the line: `- [x](url)` is a link
STEP_LINE_RE = re.compile(r"^([ \t]*)-[ \t]+\[(.)\](?:[ \t]+(.*)|[ \t]*)$")
INLINE_FIELD_RE = re.compile(r"[ \t]*\[([A-Za-z][A-Za-z0-9_-]*)::[ \t]*([^\]]*)\]")
FENCE_RE = re.compile(r"^[ \t]*(```|~~~)")
CODE_SPAN_RE = re.compile(r"`[^`]*`")
ORDERED_TRAP_RE = re.compile(r"^\d+[.)](\s|$)")
FOREIGN_BOX_RE = re.compile(r"^[ \t]*[*+][ \t]+\[.\](?:[ \t]|$)")


# real annotations, not `from __future__ import annotations`: dataclasses resolves
# string ones through sys.modules, and the test loader never registers this file
@dataclass
class Step:
    line_no: int              # 1-based, in the file
    indent: str
    state: str                # one character; `X` reads as `x`
    text: str                 # the line minus its box and trail's fields
    fields: dict              # trail's fields, in file order
    raw: str                  # the line as read; written back unless dirty
    dupes: list = field(default_factory=list)   # trail keys that appear twice
    dirty: bool = False

    @property
    def id(self) -> str:
        return self.fields.get("id", "")

    @property
    def resolved(self) -> bool:
        return self.state in RESOLVED

    @property
    def blocked(self) -> bool:
        return "blocked" in self.fields or "blocked-reason" in self.fields

    def render(self) -> str:
        parts = [self.text] if self.text else []
        parts += ["[%s:: %s]" % (k, v) for k, v in self.fields.items()]
        return ("%s- [%s] %s" % (self.indent, self.state, " ".join(parts))).rstrip()


def parse_step_line(line: str, line_no: int = 0):
    m = STEP_LINE_RE.match(line)
    if not m:
        return None
    indent, state, rest = m.group(1), m.group(2), m.group(3) or ""
    fields, dupes = {}, []
    # inline code is opaque like a fenced block: a step *about* the format
    # says `[completion:: YYYY-MM-DD]` in backticks, and that is text, not a field
    code = [(c.start(), c.end()) for c in CODE_SPAN_RE.finditer(rest)]

    def take(fm):
        key = fm.group(1).lower()
        if key not in TRAIL_FIELDS or any(a <= fm.start(1) < b for a, b in code):
            return fm.group(0)          # not ours, or quoted: stays in the text, untouched
        if key in fields:
            dupes.append(key)
        else:
            fields[key] = fm.group(2).strip()
        return ""

    text = INLINE_FIELD_RE.sub(take, rest).strip()
    return Step(line_no, indent, "x" if state == "X" else state, text, fields, line, dupes)


def step_lines(text: str):
    """(first line number, [lines]) of the `## Steps` body, or None. Both the parser
    and the writer walk this so their line numbers agree."""
    b = section_bounds(text, "Steps")
    if not b:
        return None
    return text.count("\n", 0, b[0]) + 1, text[b[0]:b[1]].splitlines(keepends=True)


def parse_steps(text: str) -> list:
    span = step_lines(text)
    if not span:
        return []
    base, lines = span
    items, fenced = [], False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            fenced = not fenced
            continue
        if fenced:
            continue
        item = parse_step_line(line.rstrip("\r\n"), base + i)
        if item:
            items.append(item)
    return items


def mutate_steps(text: str, fn) -> str:
    """parse -> fn(items) -> write back only the items fn marked dirty. Every other
    byte of the file - the rest of the section included - is returned as it was.
    Rebuilding the section from the parsed items would drop the template's comment,
    a `###` sub-heading, a note under an item, and normalise every line it touched;
    the file is hand-editable, so the CLI has to be a guest in it."""
    b = section_bounds(text, "Steps")
    if not b:
        raise TrailError("no '## Steps' section")
    items = parse_steps(text)
    fn(items)
    dirty = {it.line_no: it for it in items if it.dirty}
    if not dirty:
        return text
    base, lines = step_lines(text)
    out = []
    for i, line in enumerate(lines):
        it = dirty.get(base + i)
        if it is None:
            out.append(line)
        else:
            out.append(it.render() + line[len(line.rstrip("\r\n")):])
    return text[:b[0]] + "".join(out) + text[b[1]:]


def touch(item: Step) -> None:
    """Every mutation goes through here. A line carrying a trail field twice
    cannot be rendered without losing one of them, so it is refused rather than
    rewritten; the validator names the line."""
    if item.dupes:
        raise TrailError("line %d carries [%s:: ] twice; fix the line by hand before the "
                         "CLI rewrites it (trail validate lists it)"
                         % (item.line_no, "], [".join(sorted(set(item.dupes)))))
    item.dirty = True


# --- queries ---------------------------------------------------------------

def step_progress(text: str):
    """(verified, total) over `## Steps` checkboxes, or None when there are none.
    `[-]` is cancelled: resolved, so it leaves the denominator rather than
    sitting there as work that will never be done."""
    live = [it for it in parse_steps(text) if it.state != "-"]
    if not live:
        return None
    return sum(1 for it in live if it.state == "x"), len(live)


def steps_view(items: list) -> dict:
    """What `status` says about the steps. `next` is the first unresolved item that
    is not blocked. When it is `[/]` - written, waiting on verification - the first
    `[ ]` after it is offered as `continue_with`: work that can go on while the
    verification happens, not a claim that the first item is finished. Blocked
    items are listed apart and never chosen. `complete` is every item resolved;
    a blocked item is unresolved, so it holds the steps open."""
    live = [it for it in items if not it.resolved]
    open_ = [it for it in live if not it.blocked]
    nxt = open_[0] if open_ else None
    cont = None
    if nxt and nxt.state == "/":
        cont = next((it for it in open_[1:] if it.state == " "), None)
    return {"next": nxt, "continue_with": cont,
            "blocked": [it for it in live if it.blocked],
            "complete": bool(items) and not live}


def fmt_item(it: Step) -> str:
    return "[%s] [%s] %s" % (it.id or "no id", it.state, it.text)


def fmt_blocked(it: Step) -> str:
    return "%s · blocked since %s: %s" % (fmt_item(it), it.fields.get("blocked") or "?",
                                          it.fields.get("blocked-reason") or "(no reason)")


def item_dict(it: Step) -> dict:
    return {"id": it.id, "state": it.state, "text": it.text, "line": it.line_no,
            "completion": it.fields.get("completion"),
            "blocked": it.fields.get("blocked"),
            "blocked_reason": it.fields.get("blocked-reason")}


# --- ids -------------------------------------------------------------------

def id_prefix(slug: str) -> str:
    """Initials of the slug's parts: `user-1-profile` -> `u1p`."""
    return "".join(p[0] for p in slug.split("-") if p)


def new_item_id(prefix: str, taken, rng=random) -> str:
    while True:
        cand = "%s-%s" % (prefix, "".join(rng.choice(ID_ALPHABET) for _ in range(4)))
        if cand not in taken:
            return cand


def check_unique_ids(items: list) -> None:
    seen = {}
    for it in items:
        if it.id and it.id in seen:
            raise TrailError("duplicate step id %s on %r and %r - every step needs its own"
                             % (it.id, seen[it.id], it.text))
        seen[it.id] = it.text


def assign_ids(items: list, prefix: str, rng=random) -> list:
    """Give every id-less item an id. An id that is there stays, whatever it looks
    like: once written it never changes, and the validator reports a bad one."""
    taken = {it.id for it in items if it.id}
    given = []
    for it in items:
        if not it.id:
            touch(it)
            it.fields["id"] = new_item_id(prefix, taken, rng)
            taken.add(it.id)
            given.append(it)
    return given


def with_step_ids(body: str, prefix: str):
    """A `## Steps` body about to be written: id-less checkbox lines get ids, nothing
    else changes. Returns (body, number of ids assigned)."""
    given = []

    def fn(items):
        check_unique_ids(items)
        given.extend(assign_ids(items, prefix))

    head = "## Steps\n"
    return mutate_steps(head + body + "\n", fn)[len(head):].rstrip("\n"), len(given)


# --- mutations -------------------------------------------------------------

def _blocked_note(it: Step) -> str:
    return "%s: %s" % (it.fields.get("blocked") or "?", it.fields.get("blocked-reason") or "")


def transition(it: Step, state: str, today: str, reason: str = None) -> None:
    """Move an item between the four states. `[x]` is dated on the way in and the
    date is cleared on the way out. A blocked item can be `[ ]` or `[/]` but not
    resolved: the CLI never clears a block as a side effect, so `[x]` and `[-]`
    are refused until `trail unblock`."""
    if state in RESOLVED and it.blocked:
        raise TrailError("[%s] is blocked (%s) - unblock it first: trail unblock %s"
                         % (it.id or "no id", _blocked_note(it), it.id or "<item>"))
    if it.state == state:
        if state == "-" and reason:
            raise TrailError("[%s] is already cancelled: %s. Nothing changed - the reason "
                             "is part of the text, edit the line to change it"
                             % (it.id or "no id", it.text))
        extra = (" (completion %s)" % it.fields["completion"]
                 if state == "x" and it.fields.get("completion") else "")
        raise Unchanged("[%s] is already [%s]%s; nothing changed" % (it.id or "no id", state, extra))
    touch(it)
    it.state = state
    if state == "x":
        it.fields["completion"] = today
    else:
        it.fields.pop("completion", None)
    if state == "-" and reason:
        it.text = "%s — %s" % (it.text, reason.strip())


def clean_reason(reason: str, what: str) -> str:
    reason = (reason or "").strip()
    if not reason:
        raise TrailError("%s needs a reason" % what)
    if "\n" in reason or "]" in reason:
        raise TrailError("%s reason must be one line and cannot contain ']' "
                         "(it is written as an inline field)" % what)
    return reason


def set_blocked(it: Step, today: str, reason: str) -> None:
    if it.resolved:
        raise TrailError("[%s] is [%s] (%s); only an unfinished item can be blocked"
                         % (it.id or "no id", it.state, STEP_STATES[it.state]))
    if it.blocked:
        raise TrailError("[%s] is already blocked (%s); nothing changed.\n"
                         "       To replace the reason: trail unblock %s && trail block %s \"<reason>\""
                         % (it.id or "no id", _blocked_note(it), it.id or "<item>", it.id or "<item>"))
    touch(it)
    it.fields["blocked"] = today
    it.fields["blocked-reason"] = reason


def clear_blocked(it: Step) -> str:
    """Remove the two blocked fields and nothing else; the box is not touched."""
    if not it.blocked:
        raise Unchanged("[%s] is not blocked; nothing changed" % (it.id or "no id"))
    was = _blocked_note(it)
    touch(it)
    it.fields.pop("blocked", None)
    it.fields.pop("blocked-reason", None)
    return was


# --- resolution ------------------------------------------------------------

def fmt_items(items: list) -> str:
    return "\n".join("  " + fmt_item(it) for it in items)


def resolve_item(items: list, query: str) -> Step:
    """Exact id first, then a case-insensitive substring of the text. One hit is
    the item; zero or several is refused with the candidates listed by id, and
    nothing is written - picking one would be a guess dressed as a command."""
    q = (query or "").strip()
    if not q:
        raise TrailError("which item? pass an id or a piece of its text")
    if not items:
        raise TrailError("## Steps has no items")
    hits = [it for it in items if it.id and it.id == q.lower()]
    if len(hits) != 1:
        hits = hits or [it for it in items if q.casefold() in it.text.casefold()]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        raise TrailError("no step matches %r. The steps:\n%s" % (query, fmt_items(items)))
    raise TrailError("%d steps match %r - say which, by id:\n%s"
                     % (len(hits), query, fmt_items(hits)))


# --- validation ------------------------------------------------------------

REQUIRED_SECTIONS = ("Goal", "Steps", "Out of Scope", "Status", "Notes",
                     "Decision Log", "Open Questions")


def is_date(s) -> bool:
    try:
        return isinstance(s, str) and len(s) == 10 and date.fromisoformat(s) is not None
    except ValueError:
        return False


def validate_task(text: str, stem: str) -> list:
    """[(line, problem, fix)] against trail's own contract - frontmatter, the
    sections, the steps and their fields. Not a Markdown linter: `## Notes`
    has no rules, the decision log and the backlog are not checked, and anything
    the CLI does not read is not its business. Nothing is repaired."""
    out = []

    def add(line, problem, fix):
        out.append((line, problem, fix))

    def line_of(offset):
        return text.count("\n", 0, offset) + 1

    # frontmatter
    b = fm_bounds(text)
    if not b:
        add(1, "no frontmatter block (--- ... ---) at the top",
            "start the file with the block from .trail/_template.md")
        fm = {}
    else:
        block = text[b[0]:b[1]]
        fm = parse_yaml(block)
        where, raw = {}, {}
        for i, ln in enumerate(block.splitlines()):
            m = _KEY_RE.match(ln)
            if m and m.group(1) not in where:
                where[m.group(1)], raw[m.group(1)] = i + 2, m.group(2).strip()

        def val(key):
            v = fm.get(key)
            return v if isinstance(v, str) and v else ""

        # the rules a kind implies, then the ones that belong to one field. Findings
        # are sorted by line, so the order they are found in never shows.
        missing_fix = {"id": "set `id: %s` (the file name)" % stem,
                       # `trail set` cannot write it: only the day the file was made is right
                       "created": "add `created: YYYY-MM-DD` (the day the file was made)"}
        for key, (required, kind) in FIELDS.items():
            v, n = val(key), where.get(key, 1)
            if required and not v:
                add(n, "frontmatter: `%s` is missing or empty" % key,
                    missing_fix.get(key) or "trail set %s <value> --task %s" % (key, stem))
            elif kind == "level" and v and v.upper() not in LEVELS:
                add(n, "%s %r is not %s" % (key, v, " or ".join(LEVELS)),
                    "trail set %s %s --task %s" % (key, "|".join(LEVELS), stem))
            elif kind == "status" and v and v not in STATUSES:
                add(n, "%s %r is not one of %s" % (key, v, ", ".join(STATUSES)),
                    "trail set %s %s --task %s (%s is `trail done`)"
                    % (key, "|".join(SETTABLE_STATUSES), stem, DONE))
            elif kind == "date" and v and not is_date(v):
                add(n, "%s %r is not a YYYY-MM-DD date" % (key, v), "write the date as YYYY-MM-DD")
            elif kind == "list" and key in fm and not isinstance(fm[key], list):
                add(n, "%s is not a list" % key,
                    "one `  - path` line per link; `trail link <path>` writes the shape")
        if val("id") and val("id") != stem:
            add(where["id"], "id %r does not match the file name %r" % (val("id"), stem),
                "rename the file or fix `id:`; readers show one, commands accept both")
        if val("title") and raw["title"][:1] not in "\"'" and (
                ": " in raw["title"] or raw["title"].endswith(":")
                or raw["title"][:1] in "[{&*!|>%@`"):
            add(where["title"], "title is not quoted and is not valid YAML for other tools",
                "trail set title \"<title>\" --task %s (writes it quoted)" % stem)
        # the other way round is not reported: a task closed before `completed`
        # existed has no known close date, and inventing one is false data
        if val("completed") and val("status") != DONE:
            add(where["completed"], "completed is set but the task is not %s" % DONE,
                "delete the `completed:` line, or close the task with `trail done`")

    # sections
    for head in REQUIRED_SECTIONS:
        found = list(re.finditer(r"^##\s+" + re.escape(head) + r"\s*$", text, re.M))
        if not found:
            add(len(text.splitlines()) or 1, "missing `## %s` section" % head,
                "add the heading; the order in _template.md is %s" % " > ".join(REQUIRED_SECTIONS))
        for m in found[1:]:
            add(line_of(m.start()), "`## %s` appears more than once; the CLI reads the first" % head,
                "merge the sections")

    # steps
    span = step_lines(text)
    if span:
        base, lines = span
        fenced = False
        for i, ln in enumerate(lines):
            if FENCE_RE.match(ln):
                fenced = not fenced
            elif not fenced and FOREIGN_BOX_RE.match(ln):
                add(base + i, "checkbox with a `*`/`+` bullet is not a step to trail",
                    "write the bullet as `-`")
    items = parse_steps(text)
    seen = {}
    for it in items:
        n = it.line_no
        f = it.fields
        if it.state not in STEP_STATES:
            add(n, "unknown checkbox state [%s]" % it.state,
                "use [ ] not started, [/] written not verified, [x] verified, [-] cancelled")
        if not it.text:
            add(n, "step has no text", "write what the step is, or delete the line")
        elif ORDERED_TRAP_RE.match(it.text):
            add(n, "`%s` after the box starts an ordered list and breaks the checkbox"
                % it.text.split()[0], "number it as text: `- [ ] **1.** ...`")
        for key in sorted(set(it.dupes)):
            add(n, "[%s:: ] appears twice on the line" % key, "keep one")
        for key, v in f.items():
            if not v:
                add(n, "[%s:: ] is empty" % key, "give it a value or remove the field")
        if not it.id:
            add(n, "step has no [id:: ]",
                "`trail write steps` assigns ids to lines without one (re-pipe the section); "
                "do not invent ids by hand")
        elif not ITEM_ID_RE.match(it.id):
            add(n, "[id:: %s] is not a trail id (<initials>-<4 chars>)" % it.id,
                "remove the field and let `trail write steps` assign one")
        elif it.id in seen:
            add(n, "duplicate id %s (also on line %d)" % (it.id, seen[it.id]),
                "remove the field on one of them and re-run `trail write steps`")
        else:
            seen[it.id] = n
        comp = f.get("completion")
        if it.state == "x" and not comp:
            add(n, "[x] has no [completion:: ] date",
                "trail uncheck <id> && trail check <id> re-dates it, or add [completion:: YYYY-MM-DD]")
        if it.state != "x" and comp is not None:
            add(n, "[completion:: ] on a [%s] item" % it.state,
                "trail check <id> --partial or trail uncheck <id> clears it, or remove the field")
        if comp and not is_date(comp):
            add(n, "[completion:: %s] is not a YYYY-MM-DD date" % comp, "write it as YYYY-MM-DD")
        blk, why = f.get("blocked"), f.get("blocked-reason")
        if blk is not None and why is None:
            add(n, "[blocked:: ] without [blocked-reason:: ]",
                "trail unblock <id> clears it; trail block <id> \"<reason>\" sets both")
        if why is not None and blk is None:
            add(n, "[blocked-reason:: ] without [blocked:: ]",
                "trail unblock <id> clears it; trail block <id> \"<reason>\" sets both")
        if blk and not is_date(blk):
            add(n, "[blocked:: %s] is not a YYYY-MM-DD date" % blk, "write it as YYYY-MM-DD")
        if it.blocked and it.resolved:
            add(n, "blocked and [%s] at once - a resolved item cannot be waiting" % it.state,
                "trail unblock <id>, or trail uncheck <id> if it is not actually resolved")
    out.sort(key=lambda x: x[0])
    return out


# --------------------------------------------------------------------------
# colour - off when piped, off under NO_COLOR
# --------------------------------------------------------------------------

_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
_CODES = {"head": "1;4", "dim": "2", "id": "36", OPEN: "34", ACTIVE: "1;32",
          BLOCKED: "31", DONE: "2;32", "warn": "33", "label": "1;36"}


def c(s: str, key: str) -> str:
    if not _COLOR or key not in _CODES:
        return s
    return "\033[%sm%s\033[0m" % (_CODES[key], s)


def pad(s: str, w: int, key: str = None) -> str:
    """Pad first, colour second - escape codes must not count toward the width."""
    return c("%-*s" % (w, s), key) if key else "%-*s" % (w, s)


# --------------------------------------------------------------------------
# repo / config / tasks
# --------------------------------------------------------------------------

def find_root(start: Path = None) -> Path:
    p = (start or Path.cwd()).resolve()
    for d in [p] + list(p.parents):
        if (d / ".trail").is_dir():
            return d
        if (d / ".git").exists():
            return d    # repo boundary: a nested repo must not reach the outer ledger
    return p


def load_config(root: Path) -> dict:
    cfg = dict(DEFAULTS)
    f = root / ".trail" / "config.yml"
    if f.is_file():
        for k, v in parse_yaml(f.read_text("utf-8")).items():
            if k in cfg and not isinstance(v, list):
                cfg[k] = v
    raw = str(cfg["stale_days"]).strip()
    cfg["stale_days"] = int(raw) if raw.isdigit() else DEFAULTS["stale_days"]
    return cfg


def age_days(ts: float) -> int:
    return int((datetime.now() - datetime.fromtimestamp(ts)).total_seconds() // 86400)


def load_tasks(root: Path, cfg: dict, archived: bool = False) -> list:
    dirs = [root / cfg["dir"]]
    if archived:
        dirs.append(root / cfg["archive"])
    out = []
    for d in dirs:
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.md")):
            if f.name.startswith("_"):
                continue
            text = f.read_text("utf-8")
            fm = parse_fm(text)

            def s(key, fallback):
                v = fm.get(key)
                return v if isinstance(v, str) and v else fallback

            fallback = {"id": f.stem, "title": f.stem, "level": LEVELS[0], "status": OPEN}
            task = {"path": f, "text": text, "fm": fm}
            for key, (_, kind) in FIELDS.items():
                if kind == "list":
                    task[key] = fm[key] if isinstance(fm.get(key), list) else []
                else:
                    task[key] = s(key, fallback.get(key, ""))
            task["mtime"] = f.stat().st_mtime
            task["archived"] = d.name == Path(cfg["archive"]).name
            out.append(task)
    return out


def work_order(tasks: list):
    """Sort key: status, then id. Never mtime - the file you touched last is not
    the work that comes first. Ordering between related tasks belongs in the slug
    (`auth-1-provider`, `auth-2-session`), so `id` carries it for free."""
    order = {s: i for i, s in enumerate(STATUSES)}
    return lambda t: (order.get(t["status"], 9), t["id"])


def resolve_task(tasks: list, ident: str = None, optional: bool = False):
    """The implicit target is whatever is in progress. `blocked` counts: a task you
    parked on a dependency is still the one you are on, and refusing to hand it off
    or close it was a dead end. `optional` returns None when nothing is in progress -
    it never hides ambiguity, which is a different problem with a different answer."""
    if ident:
        for t in tasks:
            if t["id"] == ident or t["path"].stem == ident:
                return t
        raise TrailError("no such task: %s" % ident)
    for wanted in IN_PROGRESS:
        cand = [t for t in tasks if t["status"] == wanted]
        if len(cand) == 1:
            return cand[0]
        if cand:
            raise TrailError("more than one %s task, pass --task: %s"
                             % (wanted, ", ".join(t["id"] for t in cand)))
    if optional:
        return None
    raise TrailError("nothing in progress. Pick a task up with 'trail resume <slug>' "
                     "(or 'trail start <slug>'), or pass --task.")


def missing_scaffold(root: Path, cfg: dict) -> list:
    """Files `init` would create that this repo does not have. A repo initialised by
    an older trail is not broken - both files are also created lazily on first write -
    but the feature stays invisible until someone re-runs init."""
    return [cfg[k] for k in ("backlog",) if not (root / cfg[k]).exists()]


def nudges(root: Path, cfg: dict, tasks: list) -> list:
    """Derived from the ledger on disk, never from git: trail does not read commit
    history or the working tree, so a nudge is only ever about what the task file
    itself says."""
    out = []
    active = [t for t in tasks if t["status"] == ACTIVE]
    if len(active) > 1:
        out.append("%d tasks are %s (%s). Every writer now needs --task, and "
                   "status is that many contexts at once. Park the rest with "
                   "'trail set status %s --task <id>'."
                   % (len(active), ACTIVE, ", ".join(t["id"] for t in active), OPEN))
    for t in tasks:
        if t["status"] not in IN_PROGRESS:
            continue
        age = age_days(t["mtime"])
        if age >= cfg["stale_days"]:
            out.append("%s: untouched for %s days. Still active? Close it or carry on." % (t["id"], age))
        # the steps say nothing is left, the status says work is on: one of them is
        # stale, and only a person knows which
        if t["status"] == ACTIVE and steps_view(parse_steps(t["text"]))["complete"]:
            out.append("%s: every step is resolved but the task is still %s. "
                       "'trail done' closes it; if work remains, add it to ## Steps."
                       % (t["id"], ACTIVE))
        problems = validate_task(t["text"], t["path"].stem)
        if problems:
            out.append("%s: %d format problem%s in the task file - 'trail validate --task %s' "
                       "lists them" % (t["id"], len(problems), "" if len(problems) == 1 else "s",
                                       t["id"]))
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def set_config_key(path: Path, key: str, value: str) -> None:
    """Rewrite one `key: value` line in config.yml, keeping comments and order."""
    lines = path.read_text("utf-8").splitlines()
    for i, ln in enumerate(lines):
        m = _KEY_RE.match(ln)
        if m and m.group(1) == key:
            comment = ln.split("#", 1)
            lines[i] = "%s: %s%s" % (key, value, "  #" + comment[1] if len(comment) > 1 else "")
            break
    else:
        lines.append("%s: %s" % (key, value))
    path.write_text("\n".join(lines) + "\n", "utf-8")


def cmd_init(args) -> int:
    root = Path.cwd().resolve()
    if (root / ".git").exists() is False:
        print("warning: this does not look like a git repository", file=sys.stderr)
    made = []

    for sub in ("tasks",):
        d = root / ".trail" / sub
        d.mkdir(parents=True, exist_ok=True)
        keep = d / ".gitkeep"
        if not keep.exists():
            keep.write_text("", "utf-8")

    stale = []

    def copy(src: Path, dst: Path, shipped: bool = False):
        if dst.exists():
            # Only SKILL.md is shipped content; config.yml and _template.md are
            # meant to be edited, so drift there is the point, not a problem.
            if shipped and src.read_bytes() != dst.read_bytes():
                if args.force:
                    shutil.copyfile(src, dst)
                    made.append(str(dst.relative_to(root)) + " (refreshed)")
                else:
                    stale.append(str(dst.relative_to(root)))
            return
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        made.append(str(dst.relative_to(root)))

    conf = root / ".trail" / "config.yml"
    copy(INSTALL_ROOT / "templates" / "config.yml", conf)

    cfg = load_config(root)
    copy(INSTALL_ROOT / "templates" / "_template.md", root / ".trail" / "_template.md")
    # `.agents/skills` is a destination this tool writes to, so a repo that already
    # has one is already an agent repo - detecting only the per-vendor markers sent
    # those repos back to the Claude default.
    agents = args.agent or [a for a, m in AGENT_MARKERS.items() if (root / m).is_dir()]
    if not args.agent and (root / ".agents" / "skills").is_dir():
        agents.append("codex")   # any of codex/cursor/gemini resolves to .agents/skills
    if "all" in agents:
        agents = list(AGENT_SKILL_DIRS)
    if not agents:
        agents = ["claude"]
    for skills_dir in sorted({AGENT_SKILL_DIRS[a] for a in agents}):
        for name in SKILLS:
            copy(INSTALL_ROOT / "skills" / name / "SKILL.md",
                 root / skills_dir / name / "SKILL.md", shipped=True)

    ign = root / ".trail" / ".gitignore"
    if not ign.exists():
        ign.write_text(".lock\n", "utf-8")   # the advisory lock is machine state
        made.append(".trail/.gitignore")

    bl = root / cfg["backlog"]
    if not bl.exists():
        bl.parent.mkdir(parents=True, exist_ok=True)
        bl.write_text(BACKLOG_HEADER, "utf-8")
        made.append(cfg["backlog"])


    print("ready: %s" % root)
    for m in made:
        print("  + %s" % m)
    if not made:
        print("  (everything already in place)")
    for s in stale:
        print("  ! %s differs from the installed copy - 'trail init --force' overwrites it" % s)
    print("\nnext: trail start <slug> [%s]" % "|".join(LEVELS))
    print("note: .trail/ is committed by default. Add it to .gitignore if you'd rather not.")
    return 0


# Turkish letters by table, before lowercasing: `İ`.lower() is `i` plus a combining
# dot, and `ı` has nothing for NFKD to decompose. Every other accent goes through
# NFKD and loses its marks. Only new slugs are affected; an id never changes.
TURKISH_ASCII = str.maketrans("çğıöşüÇĞİÖŞÜ", "cgiosuCGIOSU")


def slugify(s: str) -> str:
    s = unicodedata.normalize("NFKD", s.translate(TURKISH_ASCII))
    s = "".join(ch for ch in s if not unicodedata.combining(ch))
    s = s.lower().strip()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-")


def cmd_start(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tpl = root / cfg["template"]
    if not tpl.is_file():
        raise TrailError("no template at %s  (did you run 'trail init'?)" % tpl)

    slug = slugify(args.slug)
    if not slug:
        raise TrailError("invalid slug")
    dest = root / cfg["dir"] / (slug + ".md")

    level = (args.level or LEVELS[0]).upper()
    if level not in LEVELS:
        raise TrailError(
            "T0 has no task file. If you are doing it now, write nothing;\n"
            "       if you are deferring it, 'trail backlog \"...\"' (%s);\n"
            "       if it needs a status and a handoff, it is at least %s."
            % (cfg["backlog"], LEVELS[0]))

    today = date.today().isoformat()
    values = {
        "id": slug,
        "title": args.title or slug,
        "level": level,
        "status": args.status,
        "date": today,
    }
    text = tpl.read_text("utf-8")
    # unknown placeholders are left untouched on purpose
    for k, v in values.items():
        text = text.replace("{{%s}}" % k, v)
    # quote after substitution: the H1 keeps the raw title, the frontmatter is valid
    text = set_field(text, "title", yaml_quote(values["title"]))
    if args.group:
        text = set_field(text, "group", slugify(args.group))
    # the dates are written, never substituted: an older template's
    # `started: {{date}}` stored the creation day, which is the mix-up `created` ends
    text = set_field(text, "created", today)
    text = change_status(text, args.status, today, new=True)

    dest.parent.mkdir(parents=True, exist_ok=True)
    # Write the file whole, then make it visible in one step. os.link is the
    # create-only-if-absent counterpart to update_task's os.replace: it refuses to
    # clobber, and no other command can ever observe the task half-written.
    # `open(dest, "x")` closed the start/start race but left that second gap - the
    # empty file was already visible, so a concurrent `log` replaced it and start's
    # own write landed on an unlinked inode, with both commands reporting success.
    tmp = dest.with_name("%s.%d.tmp" % (dest.name, os.getpid()))
    tmp.write_text(text, "utf-8")
    try:
        os.link(str(tmp), str(dest))
    except FileExistsError:
        raise TrailError("already exists: %s" % dest.relative_to(root))
    finally:
        tmp.unlink()
    print("created: %s" % dest.relative_to(root))
    return 0


SETTABLE = {
    "status": SETTABLE_STATUSES,
    "level": LEVELS,
    "title": None,
    "group": None,
}


def cmd_set(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    task = resolve_task(tasks, args.task)
    allowed = SETTABLE[args.field]
    value = args.value
    if args.field in ("status", "level"):
        value = value.lower() if args.field == "status" else value.upper()
    if args.field == "group":
        value = slugify(value)
    if allowed and value not in allowed:
        extra = " (to close, use 'trail done')" if args.field == "status" else ""
        raise TrailError("%s must be one of: %s%s"
                         % (args.field, ", ".join(allowed), extra))
    old = task["fm"].get(args.field) or task.get(args.field) or "-"
    written = yaml_quote(value) if args.field == "title" else value
    if args.field == "status":      # the dates follow the status
        update_task(root, task, lambda txt: change_status(txt, value, date.today().isoformat()))
    else:
        update_task(root, task, lambda txt: set_field(txt, args.field, written))
    print("%s: %s %s -> %s" % (task["id"], args.field, old, value or "-"))
    return 0


def cmd_backlog(args) -> int:
    """A sink, not a tracker. No ids, no status, no lifecycle - the only thing it
    guarantees is that an item the user mentioned still exists tomorrow."""
    root = find_root()
    cfg = load_config(root)
    f = root / cfg["backlog"]
    if not args.item:
        if not f.is_file():
            print("backlog is empty")
            return 0
        sys.stdout.write(f.read_text("utf-8"))
        return 0
    if not f.is_file():
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(BACKLOG_HEADER, "utf-8")
    tag = ""
    if not args.untagged:
        # optional: an untagged line is fine when nothing is in progress. Two active
        # tasks is not that case - `log` refuses there, and guessing a tag silently
        # is worse than refusing, because the wrong tag reads as fact later.
        owner = resolve_task(load_tasks(root, cfg), args.task, optional=True)
        if owner:
            tag = " #" + owner["id"]
    with f.open("a", encoding="utf-8") as fh:
        for item in args.item:
            fh.write("- [ ] %s%s\n" % (item.strip(), tag))
    print("%s: +%d%s" % (cfg["backlog"], len(args.item), tag and " (%s)" % tag.strip()))
    return 0


def backlog_count(root: Path, cfg: dict) -> int:
    f = root / cfg["backlog"]
    if not f.is_file():
        return 0
    n = 0
    for l in f.read_text("utf-8").splitlines():
        s = l.strip()
        if not s.startswith("- "):
            continue
        m = CHECKBOX_RE.match(s)
        if m and m.group(1) in "xX-":   # done or cancelled is not a pending item
            continue
        n += 1
    return n


def cmd_link(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    def add(txt):
        links = list(parse_fm(txt).get("links") or [])
        for path in args.path:
            if path not in links:
                links.append(path)
        return set_list_field(txt, "links", links)
    links = parse_fm(update_task(root, task, add)).get("links") or []
    print("%s: links -> %s" % (task["id"], ", ".join(links)))
    return 0


def cmd_write(args) -> int:
    """Replace a prose section from stdin. The alternative - an agent doing a
    literal string replace on the template's comment - fails silently."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    body = sys.stdin.read().strip()
    if not body:
        raise TrailError("empty stdin: pipe the section body in")
    canonical = {v.lower(): v for v in SECTIONS.values()}
    key = args.section.strip().lower()
    heading = SECTIONS.get(key) or canonical.get(key)
    if not heading:
        raise TrailError("section must be one of: %s" % ", ".join(sorted(set(SECTIONS.values()))))
    given = 0
    if heading == "Steps":   # the one section with structure: id-less items get ids
        body, given = with_step_ids(body, id_prefix(task["id"]))
    update_task(root, task, lambda txt: set_section(txt, heading, body, create=True))
    n = len(body.splitlines())
    print("%s: ## %s written (%d line%s%s)"
          % (task["id"], heading, n, "" if n == 1 else "s",
             (", %d id%s assigned" % (given, "" if given == 1 else "s")) if given else ""))
    return 0


def cmd_log(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    fields = {"why": args.why, "dropped": args.dropped}
    if args.stdin:
        # a long reason arrives as `--why` / `--dropped` label lines on stdin; the
        # same field from both sides is a conflict, not a concatenation
        for key, body in parse_log_stdin(sys.stdin.read()).items():
            if fields[key] is not None:
                raise TrailError("--%s given both inline and on stdin; pick one" % key)
            fields[key] = body
    entry = render_decision(args.text, fields["why"], fields["dropped"],
                            date.today().isoformat())
    update_task(root, task,
                lambda txt: append_section(txt, "Decision Log", entry, create=True))
    print("%s <- %s" % (task["id"], entry.splitlines()[0]))
    return 0


def cmd_note(args) -> int:
    """`## Notes` has no shape and no rules. It exists because the first real
    ledger pushed measurements and findings into the backlog for want of anywhere
    else, and a section nothing can write to stays empty forever."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    line = "- **%s** · %s" % (date.today().isoformat(), args.text.strip())
    update_task(root, task, lambda txt: append_section(txt, "Notes", line, create=True))
    print("%s <- %s" % (task["id"], line))
    return 0


def cmd_handoff(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    update_task(root, task, lambda txt: set_section(txt, "Status", args.text.strip()))
    print("%s: ## Status updated" % task["id"])
    return 0


def item_command(args, op) -> int:
    """The one skeleton behind check, uncheck, cancel, block and unblock. The item
    is resolved and changed inside the lock, on the text re-read there, so the line
    named a second ago is the line that changes. `op(item, today)` applies one rule
    from the step layer and returns the detail for the report; the skeleton only
    knows how to find an item, give it an id, and say what happened."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)
    today = date.today().isoformat()
    report = []

    def on_items(items):
        it = resolve_item(items, args.item)
        old = it.state
        detail = op(it, today)      # a refusal or a no-op leaves here; nothing is written
        if not it.id:
            # the line is rewritten anyway, so an id costs nothing now and lets every
            # later command name the item. It leads the fields, as `write steps` puts it.
            touch(it)
            it.fields = {"id": new_item_id(id_prefix(task["id"]), {x.id for x in items if x.id}),
                         **it.fields}
            detail += " · id assigned"
        moved = (" -> [%s]" % it.state) if it.state != old else ""
        report.append("%s: [%s] [%s]%s %s · %s" % (task["id"], it.id, old, moved, it.text, detail))

    try:
        update_task(root, task, lambda txt: mutate_steps(txt, on_items))
    except Unchanged as e:
        print("%s: %s" % (task["id"], e))
        return 0
    print(report[0])
    return 0


def _set_state(state: str, reason: str = None):
    def op(it, today):
        transition(it, state, today, reason)
        return ("completion %s" % today) if state == "x" else STEP_STATES[state]
    return op


def cmd_check(args) -> int:
    return item_command(args, _set_state("/" if args.partial else "x"))


def cmd_uncheck(args) -> int:
    return item_command(args, _set_state(" "))


def cmd_cancel(args) -> int:
    return item_command(args, _set_state("-", args.reason))


def cmd_block(args) -> int:
    reason = clean_reason(args.reason, "block")   # refused before anything is read

    def op(it, today):
        set_blocked(it, today, reason)
        return "blocked %s: %s" % (today, reason)
    return item_command(args, op)


def cmd_unblock(args) -> int:
    return item_command(args, lambda it, today: "unblocked (was %s)" % clear_blocked(it))


def cmd_done(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg), args.task)

    # The file does not move. The closed task is the most useful one in the
    # ledger - it is the only place that says what was verified and what was
    # left undone - and archiving hid it from every reader by default.
    update_task(root, task, lambda txt: change_status(txt, DONE, date.today().isoformat()))
    open_items, done_items = backlog_state(root, cfg, task["id"])

    # A closing report, not a pipeline. Nothing is copied, moved or deleted: the
    # decision log is already permanent where it was written, and the backlog's one
    # promise is that an item the user mentioned is still there tomorrow.
    print("closed:  %s" % task["id"])
    print("status:  %s -> %s" % (task["status"], DONE))
    print("file:    %s (not moved)" % task["path"].relative_to(root))
    print("log:     %d entr%s, kept in the task file"
          % (len(decision_entries(task["text"])),
             "y" if len(decision_entries(task["text"])) == 1 else "ies"))
    pr = step_progress(task["text"])
    if pr:
        items = parse_steps(task["text"])
        states = [it.state for it in items]
        rest = [("%d unverified [/]" % states.count("/")) if "/" in states else "",
                ("%d not started [ ]" % states.count(" ")) if " " in states else ""]
        rest = [r for r in rest if r]
        print("steps:   %d/%d verified%s"
              % (pr[0], pr[1], (", " + ", ".join(rest)) if rest else ""))
        left = [it for it in items if not it.resolved]
        if left:
            # by id, so the next command can name them; a blocked one says why
            print(c("           closing with steps open - deliberate?", "warn"))
            for it in left:
                print("             " + (fmt_blocked(it) if it.blocked else fmt_item(it)))
    if open_items or done_items:
        print("backlog: #%s -> %d open, %d done"
              % (task["id"], len(open_items), len(done_items)))
        for item in open_items:
            print(c("           still open: %s" % item, "warn"))
    # The close is when a linked plan doc goes stale - one said "not started" after
    # its nine tasks had closed. A nudge: trail writes nothing there. Only .md, since
    # linked code and prototypes carry no status; `plan.md:40` still points into one.
    docs = [l for l in task["links"] if re.sub(r":\d+$", "", l).lower().endswith(".md")]
    if docs:
        print("docs:    if one of these states this work's status, update it")
        for doc in docs:
            print(c("           %s" % doc, "warn"))
    return 0


def backlog_state(root: Path, cfg: dict, slug: str):
    """(open, done) backlog lines tagged with this task. Read-only on purpose: the
    first close left two deliberate open items behind, and a sink that deletes what
    it holds is not a sink."""
    f = root / cfg["backlog"]
    if not f.is_file():
        return [], []
    tag = re.compile(r"(?:^|\s)#" + re.escape(slug) + r"(?=\s|$)")
    open_items, done_items = [], []
    for line in f.read_text("utf-8").splitlines():
        s = line.strip()
        if not (s.startswith("- ") and tag.search(s)):
            continue    # substring matching counted #auth-1-extra as #auth-1's
        m = CHECKBOX_RE.match(s)
        (done_items if m and m.group(1) in "xX" else open_items).append(s)
    return open_items, done_items


def scope_to_group(tasks: list, args):
    """Narrow the readers to the group being worked on. At forty tasks a full board
    stops compressing context and starts being a project-management surface, which
    is the opposite of what this tool is for.

    Returns (tasks, label). Any explicit filter wins - `--stale 7` asks "what did I
    abandon", and narrowing that to one group answers the wrong question."""
    if getattr(args, "all", False) or any(
            getattr(args, k, None) for k in ("group", "status", "level", "stale")):
        if getattr(args, "group", None):
            g = slugify(args.group)
            return [t for t in tasks if t["group"] == g], "group %s" % g
        return tasks, ""
    groups = {t["group"] for t in tasks if t["status"] == ACTIVE and t["group"]}
    if not groups:
        return tasks, ""          # nothing active, or it carries no group
    return ([t for t in tasks if t["group"] in groups],
            "group " + " + ".join(sorted(groups)))


def cmd_resume(args) -> int:
    """Pick a task up again. The skill parks planned tasks as `open`, and every
    writer targets whatever is in progress - so without this the documented way to
    start work ('trail set status active') failed with 'no active task'."""
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    task = resolve_task(tasks, args.slug)
    if task["status"] == DONE:
        raise TrailError("%s is %s. Reopen it first: "
                         "trail set status %s --task %s" % (task["id"], DONE, OPEN, task["id"]))
    if task["status"] != ACTIVE:
        update_task(root, task, lambda txt: change_status(txt, ACTIVE, date.today().isoformat()))
        print("%s: %s -> %s" % (task["id"], task["status"], ACTIVE))
    for other in tasks:
        if other["status"] == ACTIVE and other["id"] != task["id"]:
            print(c("also %s: %s — park it with 'trail set status %s --task %s'"
                    % (ACTIVE, other["id"], OPEN, other["id"]), "warn"))
    args.task = task["id"]
    return cmd_status(args)


def _filter(tasks, args):
    out = tasks
    if getattr(args, "status", None):
        out = [t for t in out if t["status"] == args.status]
    if getattr(args, "level", None):
        out = [t for t in out if t["level"].upper() == args.level.upper()]
    if getattr(args, "stale", None):
        out = [t for t in out if age_days(t["mtime"]) >= args.stale]
    return out


def _as_dict(t):
    return dict({k: t[k] for k in FIELDS}, age_days=age_days(t["mtime"]),
                path=str(t["path"]), archived=t["archived"])


def cmd_ls(args) -> int:
    root = find_root()
    cfg = load_config(root)
    all_tasks = _filter(load_tasks(root, cfg, archived=args.all), args)
    tasks, scope = scope_to_group(all_tasks, args)
    if not args.all and not getattr(args, "status", None):
        tasks = [t for t in tasks if t["status"] != DONE]
    if args.json:   # same selection as the table: the format must not pick the data
        print(json.dumps([_as_dict(t) for t in tasks], ensure_ascii=False, indent=2))
        return 0
    if not tasks:
        print("no tasks")
        return 0
    if scope:
        print(c("%s · %d of %d tasks (--all for every task)"
                % (scope, len(tasks), len(all_tasks)), "dim"))
    tasks.sort(key=work_order(tasks))
    w = max(len(t["id"]) for t in tasks)
    groups = {}
    for t in tasks:
        groups.setdefault(t["group"], []).append(t)
    grouped = len(groups) > 1   # one group needs no header: the scope line says it
    ind = "  " if grouped else ""
    print(c("%s%s  %-4s  %-8s  %5s  %5s  %s"
            % (ind, pad("ID", w), "LVL", "STATUS", "AGE", "STEPS", "TITLE"), "head"))
    for g, items in sorted(groups.items(), key=lambda kv: (kv[0] == "", kv[0])):
        if grouped:
            print(c(g or "(ungrouped)", "id"))
        for t in items:
            pr = step_progress(t["text"])
            print("%s%s  %-4s  %s  %4dd  %5s  %s" % (
                ind, pad(t["id"], w, "id"), t["level"],
                pad(t["status"], 8, t["status"]), age_days(t["mtime"]),
                "%d/%d" % pr if pr else "-", t["title"]))
    return 0


def cmd_board(args) -> int:
    root = find_root()
    cfg = load_config(root)
    all_tasks = load_tasks(root, cfg, archived=args.all)
    tasks, scope = scope_to_group(all_tasks, args)
    tasks.sort(key=work_order(tasks))
    if scope:
        print(c("%s · %d of %d tasks (--all for every task)"
                % (scope, len(tasks), len(all_tasks)), "dim"))
    cols = [(s, [t["id"] for t in tasks if t["status"] == s]) for s in STATUSES]
    # width follows the ids; truncating them mid-word was the fastest way to make
    # the board unreadable ("report-3-rapor-say")
    width = max([len(i) for _, ids in cols for i in ids] + [len("%s (0)" % s) for s in STATUSES])
    print("  ".join(c(pad("%s (%d)" % (s, len(ids)), width), s) for s, ids in cols))
    print("  ".join("-" * width for _ in cols))
    depth = max([len(ids) for _, ids in cols] + [0])
    for i in range(depth):
        row = []
        for _, ids in cols:
            row.append(pad(ids[i] if i < len(ids) else "", width))
        print("  ".join(row).rstrip())
    if depth == 0:
        print("(empty)")
    return 0


def cmd_show(args) -> int:
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg, archived=True), args.task)
    if args.json:
        d = _as_dict(task)
        d["goal"] = get_section(task["text"], "Goal")
        d["status_note"] = get_section(task["text"], "Status")
        d["decisions"] = [l for l in get_section(task["text"], "Decision Log").splitlines() if l.strip()]
        d["steps"] = [item_dict(it) for it in parse_steps(task["text"])]
        print(json.dumps(d, ensure_ascii=False, indent=2))
        return 0
    sys.stdout.write(task["text"])
    return 0


def cmd_notes(args) -> int:
    """The rung between `status` and `show`: the last few findings, whole, and
    nothing else from the file."""
    root = find_root()
    cfg = load_config(root)
    task = resolve_task(load_tasks(root, cfg, archived=True), args.task)
    if args.n < 1:
        raise TrailError("-n takes a positive number")
    entries = bullet_entries(task["text"], "Notes")
    if not entries:
        print("%s: no notes" % task["id"])
        return 0
    shown = entries if args.all else entries[-args.n:]
    if len(shown) < len(entries):
        print("%s: last %d of %d notes (trail notes --all)"
              % (task["id"], len(shown), len(entries)))
    for title, body in shown:
        print(title)
        for line in body:
            print(line)
    return 0


SECTION_RE = re.compile(r"^##\s+(.+?)\s*$", re.M)


def search_units(text: str):
    """(heading, [lines]) per searchable unit. The decision log's unit is the whole
    entry: `why:` and `dropped:` are indented under a title line, so a line-based
    match - what `rg` gives you - reports the rejected alternative without the
    decision it belongs to. Every other section is one line per item. Headings are
    read off the file rather than hardcoded; task files are editable by hand and the
    template is configurable."""
    for m in SECTION_RE.finditer(text):
        head = m.group(1)
        if head == "Decision Log":
            for title, body in decision_entries(text):
                yield head, [title] + body
        else:
            for line in get_section(text, head).splitlines():
                if line.strip():
                    yield head, [line]


def cmd_search(args) -> int:
    root = find_root()
    cfg = load_config(root)
    q = args.query.lower()
    # the archive is searched too: "did we already reject this?" is exactly the
    # question a closed task answers, and a default that hides it answers it wrong
    tasks = sorted(load_tasks(root, cfg, archived=True), key=lambda t: t["id"])
    hits = seen = 0
    for t in tasks:
        found = [(h, lines) for h, lines in search_units(t["text"])
                 if q in "\n".join(lines).lower()]
        if not found:
            continue
        seen += 1
        hits += len(found)
        where = "%s%s" % (t["status"], ", archived" if t["archived"] else "")
        for head, lines in found:
            print("%s %s %s" % (c(t["id"], "id"), c("(%s)" % where, t["status"]),
                                c("· " + head, "dim")))
            for line in lines:
                print("  " + line)
            print("")
    if not hits:
        print("no match for %r" % args.query)
        return 0
    print(c("%d hit%s in %d task%s"
            % (hits, "" if hits == 1 else "s", seen, "" if seen == 1 else "s"), "dim"))
    return 0


def cmd_validate(args) -> int:
    """Every task file, or one. Each finding is an error and nothing is repaired:
    the file is hand-editable, and a repair would be a guess about which side of
    a contradiction is the right one."""
    root = find_root()
    cfg = load_config(root)
    tasks = sorted(load_tasks(root, cfg), key=lambda t: t["id"])
    if args.task:
        tasks = [resolve_task(tasks, args.task)]
    bad = found = 0
    for t in tasks:
        problems = validate_task(t["text"], t["path"].stem)
        if not problems:
            continue
        bad += 1
        found += len(problems)
        print(t["path"].relative_to(root))
        for line, problem, fix in problems:
            head = "  line %d: " % line
            print(head + problem)
            print(" " * len(head) + "fix: " + fix)
    files = "%d task file%s" % (len(tasks), "" if len(tasks) == 1 else "s")
    if found:
        print("%d problem%s in %d of %s" % (found, "" if found == 1 else "s", bad, files))
        return 1
    print("ok: %s valid" % files)
    return 0


def cmd_status(args) -> int:
    root = find_root()
    cfg = load_config(root)
    tasks = load_tasks(root, cfg)
    live = ([resolve_task(tasks, args.task)] if args.task
            else [t for t in tasks if t["status"] in IN_PROGRESS])
    ns = nudges(root, cfg, tasks)
    gap = missing_scaffold(root, cfg)
    if gap:
        ns.append("this repo predates part of the scaffold (%s) - run 'trail init'"
                  % ", ".join(gap))
    n_backlog = backlog_count(root, cfg)

    if args.json:
        print(json.dumps({
            "root": str(root),
            "tasks": [dict(_as_dict(t), steps=[item_dict(it) for it in parse_steps(t["text"])])
                      for t in live],
            "backlog_items": n_backlog,
            "nudges": ns,
        }, ensure_ascii=False, indent=2))
        return 0

    # --inject feeds a hook or an agent: never colour it, never pad it
    lab = (lambda s: s) if args.inject else (lambda s: c(s, "label"))
    lines = []
    for t in live:
        # one block per label, blank line between them: these are long lines and
        # they run together otherwise
        head = "%s %s (%s, %s" % (lab("Task:"), t["id"], t["level"], t["status"])
        if t["group"]:
            head += ", group %s" % t["group"]
        for key in ("created", "started"):     # each only when set
            if t[key]:
                head += ", %s %s" % (key, t[key])
        blocks = [head + ")"]
        goal = get_section(t["text"], "Goal")
        if goal:
            blocks.append(lab("Goal:") + " " + goal.replace("\n", " "))
        items = parse_steps(t["text"])
        if items:
            pr = step_progress(t["text"])
            if pr:
                blocks.append(lab("Steps:") + " %d/%d verified" % pr)
            view = steps_view(items)
            if view["next"]:
                blocks.append(lab("Next:") + "\n  " + fmt_item(view["next"]))
                if view["continue_with"]:
                    blocks.append(lab("Can continue with:") + "\n  " + fmt_item(view["continue_with"]))
            elif view["blocked"]:
                blocks.append(lab("Next:") + " none - every remaining item is blocked")
            else:
                blocks.append(lab("Next:") + " none - every step is resolved")
            if view["blocked"]:
                blocks.append(lab("Blocked:") + "\n"
                              + "\n".join("  " + fmt_blocked(it) for it in view["blocked"]))
        st = get_section(t["text"], "Status")
        if st:
            blocks.append(lab("Status:") + " " + st.replace("\n", " "))
        # the boundary is short and it is the one section that stops the wrong work
        # being done; leaving it out of the digest was how scope got lost
        scope = get_section(t["text"], "Out of Scope")
        if scope:
            blocks.append(lab("Out of scope:") + "\n" + scope)
        if t["links"]:
            blocks.append(lab("Links:") + " " + ", ".join(t["links"]))
        # titles only: printing five full entries put ~4k characters of prose in
        # front of every session, and nobody read it. `--full` still can.
        dec = decision_entries(t["text"])
        if dec:
            # keep the target: a bare `--full` re-selects active/blocked tasks, so the
            # task being read here would vanish from the very command that explains it
            more = "trail status%s --full" % (" --task " + t["id"] if args.task else "")
            block = [lab("Recent decisions") + " (%s for the reasons):" % more]
            for title, body in dec[-5:]:
                block.append("  " + title)
                if args.full:
                    block.extend("  " + b for b in body)
            blocks.append("\n".join(block))
        # A digest must not hide that it is one. Counts, not content: a new session
        # cannot ask for what it does not know exists.
        def entries(sec):
            body = get_section(t["text"], sec)
            bullets = [l for l in body.splitlines() if l.strip().startswith("- ")]
            return bullets or [l for l in body.splitlines() if l.strip()]
        inv = []
        n = len(bullet_entries(t["text"], "Notes"))   # the count `trail notes` will confirm
        if n:
            inv.append("Notes %d (trail notes)" % n)
        n = len(entries("Open Questions"))
        if n:
            inv.append("Open Questions %d" % n)
        if len(dec) > 5:
            inv.append("Decisions %d (last 5 above)" % len(dec))
        if inv:
            blocks.append("%s %s — trail show %s"
                          % (lab("Not shown:"), " · ".join(inv), t["id"]))
        lines.append("\n\n".join(blocks))
        lines.append("")
    if n_backlog:
        lines.append("backlog: %d open item%s (trail backlog)"
                     % (n_backlog, "" if n_backlog == 1 else "s"))
        lines.append("")
    if ns:
        lines.append(lab("Nudges:"))
        lines.extend("  - " + n for n in ns)
        lines.append("")
    if not live and not ns and not n_backlog:
        lines.append("No active task.")

    if args.inject:
        if not live and not ns and not n_backlog:
            return 0
        lines.append("Write it the moment you decide: trail log \"<decision>\" --why ... --dropped ...")
        print("===BEGIN TRAIL===")
        print("\n".join(lines).strip())
        print("===END TRAIL===")
    else:
        print("\n".join(lines).strip())
    return 0


# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="trail", description="task ledger for repos",
        epilog="--no-color (any position) or NO_COLOR=1 turns colour off; "
               "it is off already when stdout is not a terminal.")
    p.add_argument("--version", action="version", version="trail " + VERSION)
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("init", help="set up .trail/ in this repo")
    s.add_argument("--force", action="store_true",
                   help="overwrite a SKILL.md that has drifted from the installed copy")
    s.add_argument("--agent", action="append",
                   choices=sorted(AGENT_SKILL_DIRS) + ["all"],
                   help="where to write SKILL.md (default: detect the agents this repo uses)")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("start", help="new task file")
    s.add_argument("slug")
    s.add_argument("level", nargs="?", help="%s (default) or %s; T0 has no file"
                   % (LEVELS[0], " or ".join(LEVELS[1:])))
    s.add_argument("--title")
    s.add_argument("--status", choices=SETTABLE_STATUSES, default=ACTIVE,
                   help="use '%s' when planning in bulk; default %s" % (OPEN, ACTIVE))
    s.add_argument("--group", help="shared label for tasks from one plan run")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("set", help="change a frontmatter field")
    s.add_argument("field", choices=sorted(SETTABLE))
    s.add_argument("value")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("backlog", help="small items; no args prints the list")
    s.add_argument("--untagged", action="store_true",
                   help="do not tag the item with the active task")
    s.add_argument("--task", help="tag with this task instead of the active one")
    s.add_argument("item", nargs="*")
    s.set_defaults(fn=cmd_backlog)

    s = sub.add_parser("link", help="attach a repo path (code or doc) to a task")
    s.add_argument("path", nargs="+")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_link)

    s = sub.add_parser("write", help="write a prose section from stdin")
    s.add_argument("section", help=", ".join(sorted(SECTIONS)))
    s.add_argument("--task")
    s.set_defaults(fn=cmd_write)

    s = sub.add_parser("log", help="append one line to the decision log")
    s.add_argument("text")
    s.add_argument("--why")
    s.add_argument("--dropped")
    s.add_argument("--stdin", action="store_true",
                   help="read the reasons from stdin: a `--why` or `--dropped` line, then its body")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("note", help="append a dated line to ## Notes")
    s.add_argument("text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_note)

    s = sub.add_parser("handoff", help="rewrite the ## Status section")
    s.add_argument("text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_handoff)

    s = sub.add_parser("check", help="step -> [x] verified, dated today")
    s.add_argument("item", help="an id, or a piece of the item's text")
    s.add_argument("--partial", action="store_true", help="-> [/] written, not verified")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser("uncheck", help="step -> [ ] not started")
    s.add_argument("item", help="an id, or a piece of the item's text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_uncheck)

    s = sub.add_parser("cancel", help="step -> [-] cancelled")
    s.add_argument("item", help="an id, or a piece of the item's text")
    s.add_argument("reason", nargs="?", help="appended to the item's text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_cancel)

    s = sub.add_parser("block", help="mark a step as waiting; the box is not touched")
    s.add_argument("item", help="an id, or a piece of the item's text")
    s.add_argument("reason", help="one line, written as [blocked-reason:: ...]")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_block)

    s = sub.add_parser("unblock", help="clear a step's block; the box is not touched")
    s.add_argument("item", help="an id, or a piece of the item's text")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_unblock)

    s = sub.add_parser("done", help="close a task and report what is around it")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_done)

    s = sub.add_parser("ls", help="task list")
    s.add_argument("--status", choices=STATUSES)
    s.add_argument("--level")
    s.add_argument("--stale", type=int, metavar="N")
    s.add_argument("--group", help="one group instead of the active task's")
    s.add_argument("--all", action="store_true",
                   help="every task and every group, plus a legacy archive")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("board", help="terminal kanban")
    s.add_argument("--group", help="one group instead of the active task's")
    s.add_argument("--all", action="store_true",
                   help="every task and every group, plus a legacy archive")
    s.set_defaults(fn=cmd_board)

    s = sub.add_parser("show", help="one task in full")
    s.add_argument("task", nargs="?")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("notes", help="the last few ## Notes entries, whole")
    s.add_argument("-n", type=int, default=5, metavar="N", help="how many (default 5)")
    s.add_argument("--all", action="store_true")
    s.add_argument("--task")
    s.set_defaults(fn=cmd_notes)

    s = sub.add_parser("search", help="find a decision, note or step by text")
    s.add_argument("query")
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("validate", help="check the task files against trail's format")
    s.add_argument("--task", help="one task instead of every file in the tasks dir")
    s.set_defaults(fn=cmd_validate)

    s = sub.add_parser("status", help="what is in progress + nudges")
    s.add_argument("--task", help="one task by slug, whatever its status")
    s.add_argument("--full", action="store_true",
                   help="print the why/dropped bodies, not just decision titles")
    s.add_argument("--inject", action="store_true", help="wrap in delimiters for context injection")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("resume", help="pick a task up again and print its status")
    s.add_argument("slug")
    s.set_defaults(fn=cmd_resume, task=None, full=False, inject=False, json=False)
    return p


def main(argv=None) -> int:
    global _COLOR
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--no-color" in argv:          # accepted anywhere, so no subparser plumbing
        argv = [a for a in argv if a != "--no-color"]
        _COLOR = False
    if os.environ.get("TRAIL_DISABLED") == "1":
        return 0
    args = build_parser().parse_args(argv)
    if not getattr(args, "fn", None):
        build_parser().print_help()
        return 1
    try:
        return args.fn(args)
    except TrailError as e:
        print("trail: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
